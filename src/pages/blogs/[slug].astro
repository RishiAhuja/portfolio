---
import type { GetStaticPaths } from 'astro';
import { fetchHashnodePosts, fetchHashnodePostBySlug } from '../../lib/hashnode';

export const getStaticPaths = (async () => {
  const username = 'rishi2220';
  const posts = await fetchHashnodePosts(username, 50);

  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const post = await fetchHashnodePostBySlug('rishi2220', slug!);

if (!post) {
  return Astro.redirect('/404');
}

return Astro.redirect(post.directUrl, 302);
---
