---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchHashnodePosts, fetchHashnodePostBySlug } from '../../lib/hashnode';
import { marked } from 'marked';
import markedKatex from 'marked-katex-extension';
import hljs from 'highlight.js';

// Configure marked with extensions
marked.use(markedKatex({
  throwOnError: false,
  output: 'html'
}));

// Configure code highlighting
marked.setOptions({
  highlight: function(code, lang) {
    if (lang && hljs.getLanguage(lang)) {
      try {
        return hljs.highlight(code, { language: lang }).value;
      } catch (err) {
        console.error('Highlight error:', err);
      }
    }
    return hljs.highlightAuto(code).value;
  },
  langPrefix: 'hljs language-',
  breaks: true,
  gfm: true,
});

export const getStaticPaths = (async () => {
  const username = 'rishi2220';
  const posts = await fetchHashnodePosts(username, 50); // Fetch more posts for static generation
  
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const username = 'rishi2220';

const post = await fetchHashnodePostBySlug(username, slug!);

if (!post) {
  return Astro.redirect('/404');
}

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};

// Render markdown to HTML
const htmlContent = marked(post.content.markdown);
---

<BaseLayout 
  title={`${post.title} | Rishi Ahuja`}
  description={post.brief}
>
  <!-- Add KaTeX and Highlight.js CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous" slot="head">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" slot="head">
  
  <main class="min-h-screen" style="background-color: #191919;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {/* Back button */}
      <a 
        href="/"
        class="inline-flex items-center gap-2 text-sm font-ptMono text-accent hover:text-accent transition-colors mb-8"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>

      <article class="prose prose-invert prose-lg max-w-none">
        {/* Header */}
        <header class="mb-8 pb-8 border-b border-darkGrey">
          {/* Cover Image */}
          {post.coverImage && (
            <div class="mb-6 rounded-sm overflow-hidden">
              <img 
                src={post.coverImage.url} 
                alt={post.title}
                class="w-full h-auto object-cover"
              />
            </div>
          )}

          <h1 class="text-4xl md:text-5xl font-bold font-ptMono text-quillGray mb-4">
            {post.title}
          </h1>
          
          <p class="text-xl font-ptMono text-gunSmoke mb-6">
            {post.brief}
          </p>
          
          <div class="flex flex-wrap items-center gap-4 text-sm font-ptMono text-gunSmoke mb-4">
            <div class="flex items-center gap-2">
              {post.author.profilePicture && (
                <img 
                  src={post.author.profilePicture} 
                  alt={post.author.name}
                  class="w-8 h-8 rounded-full"
                />
              )}
              <span>{post.author.name}</span>
            </div>
            <span>•</span>
            <time datetime={post.dateAdded}>
              {formatDate(post.dateAdded)}
            </time>
            <span>•</span>
            <span>{post.readTimeInMinutes} min read</span>
          </div>
          
          {post.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {post.tags.map((tag) => (
                <span class="text-xs font-ptMono text-accent bg-darkGrey/50 px-2 py-1 rounded-sm">
                  {tag.name}
                </span>
              ))}
            </div>
          )}
        </header>

        {/* Blog Content */}
        <div class="blog-content font-ptMono text-quillGray leading-relaxed" set:html={htmlContent}>
        </div>

        {/* Footer */}
        <div class="mt-12 pt-8 border-t border-darkGrey">
          <div class="flex items-center justify-between">
            <div class="text-sm font-ptMono text-gunSmoke">
              Originally published on <a href={post.directUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Hashnode</a>
            </div>
            <div class="flex gap-4 text-sm font-ptMono text-gunSmoke">
              <span>{post.totalReactions} reactions</span>
              <span>{post.responseCount} comments</span>
            </div>
          </div>
        </div>
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  /* Blog content styling */
  .blog-content :global(h1) {
    @apply text-4xl font-bold font-ptMono text-quillGray mt-12 mb-6;
  }
  
  .blog-content :global(h2) {
    @apply text-3xl font-bold font-ptMono text-quillGray mt-10 mb-5;
  }
  
  .blog-content :global(h3) {
    @apply text-2xl font-bold font-ptMono text-quillGray mt-8 mb-4;
  }
  
  .blog-content :global(h4) {
    @apply text-xl font-bold font-ptMono text-quillGray mt-6 mb-3;
  }
  
  .blog-content :global(p) {
    @apply text-base font-ptMono text-gunSmoke leading-relaxed mb-6;
  }
  
  .blog-content :global(a) {
    @apply text-accent underline decoration-1 decoration-accent/50 hover:decoration-accent transition-all;
  }
  
  .blog-content :global(strong) {
    @apply text-quillGray font-bold;
  }
  
  .blog-content :global(em) {
    @apply italic text-gunSmoke;
  }
  
  .blog-content :global(img) {
    @apply rounded-sm border border-darkGrey my-8 w-full h-auto;
  }
  
  .blog-content :global(blockquote) {
    @apply border-l-4 border-accent pl-6 py-2 italic text-gunSmoke my-6 bg-darkGrey/20 rounded-r-sm;
  }
  
  .blog-content :global(code) {
    @apply bg-darkGrey/50 px-2 py-0.5 rounded-sm text-accent text-sm font-mono;
  }
  
  .blog-content :global(pre) {
    @apply bg-darkGrey/30 p-4 rounded-sm overflow-x-auto my-6 border border-darkGrey/50;
  }
  
  .blog-content :global(pre code) {
    @apply bg-transparent p-0 text-sm;
  }
  
  .blog-content :global(ul), 
  .blog-content :global(ol) {
    @apply ml-6 mb-6 space-y-2;
  }
  
  .blog-content :global(li) {
    @apply text-base font-ptMono text-gunSmoke;
  }
  
  .blog-content :global(ul li) {
    @apply list-disc;
  }
  
  .blog-content :global(ol li) {
    @apply list-decimal;
  }
  
  .blog-content :global(table) {
    @apply w-full border-collapse my-6;
  }
  
  .blog-content :global(th) {
    @apply border border-darkGrey bg-darkGrey/30 px-4 py-2 text-left font-bold text-quillGray;
  }
  
  .blog-content :global(td) {
    @apply border border-darkGrey px-4 py-2 text-gunSmoke;
  }
  
  .blog-content :global(hr) {
    @apply border-darkGrey my-8;
  }

  /* KaTeX/LaTeX styling */
  .blog-content :global(.katex) {
    @apply text-quillGray;
  }
  
  .blog-content :global(.katex-display) {
    @apply my-6 overflow-x-auto;
  }
</style>
