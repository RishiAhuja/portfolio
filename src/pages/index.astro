---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="flex min-h-screen flex-col items-center justify-center">
    <div class="text-center">
      <h1 class="text-4xl font-bold font-ptMono text-quillGray mb-4">
        Astro Migration in Progress
      </h1>
      <p class="text-lg font-ptMono text-gunSmoke">
        Portfolio migration from Next.js to Astro
      </p>
      <div class="mt-8 flex gap-4 justify-center">
        <div class="px-4 py-2 border border-accent rounded-sm">
          <span class="text-accent font-ptMono">✓ Astro Setup Complete</span>
        </div>
        <div class="px-4 py-2 border border-darkGrey rounded-sm">
          <span class="text-gunSmoke font-ptMono">Components Migration</span>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
