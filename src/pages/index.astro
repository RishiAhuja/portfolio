---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';

// Import React components (will be hydrated as islands)
import AboutMe from '../components/AboutMe';
import TechStacks from '../components/TechStacks';
import Projects from '../components/Projects.astro';
import BlogPosts from '../components/BlogPosts';
import PapersReading from '../components/PapersReading';
import Upstream from '../components/Upstream';
import SideQuests from '../components/SideQuests';
import Experience from '../components/Experience.astro';
import EducationTimeline from '../components/EducationTimeline';
import ContactSocial from '../components/ContactSocial';
import Footer from '../components/Footer';
import Navigation from '../components/Navigation';
import BackToTop from '../components/ui/BackToTop';
import FadeInSection from '../components/ui/FadeInSection';
import { researchPapers } from '../data/research';

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Rishi Ahuja",
  "url": "https://rishia.in",
  "jobTitle": "Builder, Researcher, and Engineer",
  "sameAs": [
    "https://github.com/RishiAhuja",
    "https://www.linkedin.com/in/rishi-ahuja-b1a224310",
    "https://twitter.com/Rishi2220"
  ],
  "knowsAbout": ["Web Development", "Mobile Development", "Research", "Fraud Detection", "Flutter", "React", "TypeScript"],
  "workExample": [
    {
      "@type": "CreativeWork",
      "name": "Fern",
      "url": "https://fernkit.in"
    },
    {
      "@type": "CreativeWork",
      "name": "Nexus",
      "url": "https://nexus.rishia.in"
    }
  ]
};

const featuredResearch = researchPapers.slice(0, 2);
---

<BaseLayout
  title="Rishi Ahuja | Builder, Researcher, Engineer"
  description="Portfolio of Rishi Ahuja - builder, researcher, and engineer at NIT Jalandhar. Presented at ICLR 2026 in Rio de Janeiro and accepted at IJCAI-ECAI 2026 in Bremen."
  image="/og?title=Rishi%20Ahuja&description=Builder%20%7C%20Researcher%20%7C%20Engineer&type=default"
>
  <JsonLd data={schema} />
  <Navigation client:load />
  
  <main class="flex min-h-screen flex-col items-center">
    <div class="w-full max-w-4xl px-4 md:px-8 py-8">
      <section id="about">
        <AboutMe client:load />
      </section>
      
      <!-- <div class="h-8" /> -->
      
      <!-- <section id="tech">
        <FadeInSection client:visible>
          <TechStacks client:visible />
        </FadeInSection>
      </section> -->

      <div class="h-8" />

      <section id="research">
        <FadeInSection client:visible delay={100}>
          <div class="space-y-3">
            <div class="flex items-end justify-between gap-4">
              <div>
                <p class="text-xs font-ptMono text-accent-light/80 mb-2">Research</p>
                <h2 class="text-sm md:text-base font-ptMono font-medium text-quillGray leading-snug">
                  Two papers across ICLR 2026 and IJCAI-ECAI 2026.
                </h2>
              </div>
              <a href="/research" class="hidden md:inline-flex items-center gap-1 text-sm font-ptMono text-gunSmoke hover:text-accent-light transition-colors">
                View all
                <span>→</span>
              </a>
            </div>

            {featuredResearch.map((paper) => (
              <a href="/research" class="block w-full border border-darkGrey/40 rounded-sm p-5 md:p-6 bg-bgShades-light/50 hover:border-accent-light/40 transition-all duration-300 group">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-ptMono text-accent-light/80 mb-2">
                      {paper.status} · {paper.venue}
                    </p>
                    <h3 class="text-sm md:text-base font-ptMono font-medium text-quillGray group-hover:text-accent-light transition-colors duration-200 leading-snug">
                      {paper.title}
                    </h3>
                  </div>
                  <span class="text-gunSmoke group-hover:text-accent-light transition-colors duration-200 flex-shrink-0 mt-1">→</span>
                </div>
              </a>
            ))}

            <div class="md:hidden pt-1">
              <a href="/research" class="inline-flex items-center gap-1 text-sm font-ptMono text-gunSmoke hover:text-accent-light transition-colors">
                View all
                <span>→</span>
              </a>
            </div>
          </div>
        </FadeInSection>
      </section>

      <div class="h-8" />
      
      <section id="blog">
        <FadeInSection client:visible delay={150}>
          <BlogPosts client:visible />
        </FadeInSection>
      </section>
      
      <div class="h-8" />
      
      <section id="papers">
        <FadeInSection client:visible delay={175}>
          <PapersReading client:visible />
        </FadeInSection>
      </section>

      <div class="h-8" />
      
      <section id="sidequests">
        <FadeInSection client:visible delay={275}>
          <SideQuests client:visible />
        </FadeInSection>
      </section>

      <div class="h-8" />
      
      <section id="experience">
        <FadeInSection client:visible delay={200}>
          <Experience />
        </FadeInSection>
      </section>

      <div class="h-8" />
      <section id="upstream">
        <FadeInSection client:visible delay={125}>
          <Upstream client:visible />
        </FadeInSection>
      </section>

      <div class="h-8" />
      
      <section id="education">
        <FadeInSection client:visible delay={250}>
          <EducationTimeline client:visible />
        </FadeInSection>
      </section>

      <div class="h-8" />
      
      <section id="projects">
        <FadeInSection client:visible delay={100}>
          <Projects />
        </FadeInSection>
      </section>
      
      <div class="h-8" />
      
      <section id="contact">
        <FadeInSection client:visible delay={300}>
          <ContactSocial client:visible />
        </FadeInSection>
      </section>
      
      <div class="h-8" />
      
      <Footer client:load />
    </div>
    
    <BackToTop client:idle />
  </main>
</BaseLayout>
