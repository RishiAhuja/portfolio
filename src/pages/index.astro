---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';

// Import React components (will be hydrated as islands)
import AboutMe from '../components/AboutMe';
import Projects from '../components/Projects.astro';
import BlogPosts from '../components/BlogPosts';
import PapersReading from '../components/PapersReading';
import Upstream from '../components/Upstream';
import SideQuests from '../components/SideQuests';
import Experience from '../components/Experience.astro';
import EducationTimeline from '../components/EducationTimeline';
import ContactSocial from '../components/ContactSocial';
import Footer from '../components/Footer';
import Navigation from '../components/Navigation';
import BackToTop from '../components/ui/BackToTop';
import FadeInSection from '../components/ui/FadeInSection';
import ResearchPublications from '../components/ResearchPublications.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Rishi Ahuja",
  "url": "https://rishia.in",
  "jobTitle": "Builder, Researcher, and Engineer",
  "sameAs": [
    "https://github.com/RishiAhuja",
    "https://www.linkedin.com/in/rishi-ahuja-b1a224310",
    "https://twitter.com/Rishi2220"
  ],
  "knowsAbout": ["Web Development", "Mobile Development", "Research", "Fraud Detection", "Flutter", "React", "TypeScript"],
  "workExample": [
    {
      "@type": "CreativeWork",
      "name": "Fern",
      "url": "https://fernkit.in"
    },
    {
      "@type": "CreativeWork",
      "name": "Nexus",
      "url": "https://nexus.rishia.in"
    }
  ]
};

const featuredResearch = (await getCollection('research'))
  .sort((a, b) => b.data.sort_date.getTime() - a.data.sort_date.getTime())
  .slice(0, 2);
---

<BaseLayout
  title="Rishi Ahuja | Builder, Researcher, Engineer"
  description="Portfolio of Rishi Ahuja - builder, researcher, and engineer at NIT Jalandhar. Presented at ICLR 2026 in Rio de Janeiro and accepted to IJCAI-ECAI 2026, to be presented in Bremen."
  image="/og?title=Rishi%20Ahuja&description=Builder%20%7C%20Researcher%20%7C%20Engineer&type=default"
>
  <JsonLd data={schema} />
  <Navigation client:load />
  
  <main class="flex min-h-screen flex-col items-center">
    <div class="w-full max-w-4xl px-4 md:px-8 py-8">
      <section id="about">
        <AboutMe client:load />
      </section>
      
      <!-- <div class="h-8" /> -->
      
      <!-- <section id="tech">
        <FadeInSection client:visible>
          <TechStacks client:visible />
        </FadeInSection>
      </section> -->

      <div class="h-8" />

      <section id="research">
        <FadeInSection client:visible delay={100}>
          <ResearchPublications
            papers={featuredResearch}
            heading="Things I've published"
            viewAllHref="/research"
          />
        </FadeInSection>
      </section>

      <div class="h-8" />
      
      <section id="blog">
        <FadeInSection client:visible delay={150}>
          <BlogPosts client:visible />
        </FadeInSection>
      </section>
      
      <div class="h-8" />
      
      <section id="papers">
        <FadeInSection client:visible delay={175}>
          <PapersReading client:visible />
        </FadeInSection>
      </section>

      <div class="h-8" />
      
      <section id="sidequests">
        <FadeInSection client:visible delay={275}>
          <SideQuests client:visible />
        </FadeInSection>
      </section>

      <div class="h-8" />
      
      <section id="experience">
        <FadeInSection client:visible delay={200}>
          <Experience />
        </FadeInSection>
      </section>

      <div class="h-8" />
      <section id="upstream">
        <FadeInSection client:visible delay={125}>
          <Upstream client:visible />
        </FadeInSection>
      </section>

      <div class="h-8" />
      
      <section id="education">
        <FadeInSection client:visible delay={250}>
          <EducationTimeline client:visible />
        </FadeInSection>
      </section>

      <div class="h-8" />
      
      <section id="projects">
        <FadeInSection client:visible delay={100}>
          <Projects />
        </FadeInSection>
      </section>
      
      <div class="h-8" />
      
      <section id="contact">
        <FadeInSection client:visible delay={300}>
          <ContactSocial client:visible />
        </FadeInSection>
      </section>
      
      <div class="h-8" />
      
      <Footer client:load />
    </div>
    
    <BackToTop client:idle />
  </main>
</BaseLayout>
