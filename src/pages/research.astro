---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs';

const breadcrumbs = [
  { label: 'Rishi', href: '/' },
  { label: 'Research' }
];

const paper = {
  title: 'Retrieval Mechanisms Surpass Long-Context Scaling in Time Series Forecasting',
  authors: [
    { name: 'Rishi Ahuja', isMe: true, profile: 'https://openreview.net/profile?id=~Rishi_Ahuja1' },
    { name: 'Kumar Prateek', isMe: false, profile: 'https://openreview.net/profile?id=~Kumar_Prateek1' },
    { name: 'Simranjit Singh', isMe: false, profile: 'https://openreview.net/profile?id=~Simranjit_Singh4' },
    { name: 'Dr Vijay Kumar', isMe: false, profile: 'https://openreview.net/profile?id=~Dr_Vijay_Kumar1' },
  ],
  venue: '1st ICLR Workshop on Time Series in the Age of Large Models',
  proceedings: 'Proceedings of ICLR 2026',
  publishedDate: 'March 2, 2026',
  tldr: 'Long contexts hurt time series forecasting by adding noise (inverse scaling, >68% worse at 3k steps), while selective retrieval (RAFT) beats them with lower MSE (0.379 vs 0.647) and less compute — future TSFMs should embed retrieval instead.',
  abstract: `Time Series Foundation Models (TSFMs) have borrowed the long context paradigm from natural language processing under the premise that feeding more history into the model improves forecast quality. But in stochastic domains, distant history is often just high-frequency noise, not signal. Hence, the proposed work tests whether this premise actually holds by running continuous context architectures (PatchTST included) through the ETTh1 benchmark. The obtained results contradict the premise: an inverse scaling law shows up clearly, with forecasting error rising as context gets longer. A 3,000-step window causes performance to drop by over 68%, evidence that attention mechanisms are poor at ignoring irrelevant historical volatility. Retrieval-Augmented Forecasting (RAFT) is evaluated as an alternative. RAFT achieves a mean squared error (MSE) of 0.379 with a fixed 720-step window and selective retrieval, well below the 0.647 MSE of the best long-context configuration despite requiring far less computation. In addition, the retrieval step injects only the most relevant historical segments as dynamic exogenous variables, which gives the model a context-informed inductive bias it cannot build on its own from raw sequences. Therefore, foundation models going forward need to shift architecturally toward selective retrieval.`,
  forumUrl: 'https://openreview.net/forum?id=Qj96MlCmZw',
  pdfUrl: 'https://openreview.net/pdf?id=Qj96MlCmZw',
  posterUrl: 'https://artifacts.rishia.in/research/ahuja2026retrieval/poster.pdf',
  iclrVirtualUrl: 'https://iclr.cc/virtual/2026/10013856',
  githubUrl: 'https://github.com/RishiAhuja/ahuja2026retrieval',
  tsalmUrl: 'https://tsalm-workshop.github.io/',
  bibtex: `@inproceedings{
  ahuja2026retrieval,
  title={Retrieval Mechanisms Surpass Long-Context Scaling in Time Series Forecasting},
  author={Rishi Ahuja and Kumar Prateek and Simranjit Singh and Dr Vijay Kumar},
  booktitle={1st ICLR Workshop on Time Series in the Age of Large Models},
  year={2026},
  url={https://openreview.net/forum?id=Qj96MlCmZw}
}`,
};

const presentationDetails = {
  city: 'Rio de Janeiro',
  country: 'Brazil',
  workshopStartDate: '2026-04-26',
  workshopEndDate: '2026-04-27',
  workshopDatesLabel: 'Apr 26–27, 2026',
  grantLabel: '$2,025',
  conferenceUrl: 'https://iclr.cc/Conferences/2026',
  conferenceDatesUrl: 'https://iclr.cc/Conferences/2026/Dates'
};

const canonicalResearchUrl = 'https://rishia.in/research';
---

<BaseLayout
  title="Research | Rishi Ahuja"
  description="Research publications by Rishi Ahuja. Retrieval Mechanisms Surpass Long-Context Scaling in Time Series Forecasting — Proceedings of ICLR 2026."
  image="/og?title=Research&description=Publications%20%26%20Papers&type=default"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ScholarlyArticle',
    headline: paper.title,
    author: paper.authors.map((author) => ({
      '@type': 'Person',
      name: author.name,
      url: author.profile
    })),
    datePublished: '2026-03-02',
    award: `ICLR 2026 travel grant (${presentationDetails.grantLabel})`,
    isPartOf: {
      '@type': 'Event',
      name: paper.venue,
      startDate: presentationDetails.workshopStartDate,
      endDate: presentationDetails.workshopEndDate,
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Riocentro Convention and Event Center',
        address: {
          '@type': 'PostalAddress',
          addressLocality: presentationDetails.city,
          addressCountry: presentationDetails.country
        }
      },
      url: presentationDetails.conferenceUrl
    },
    abstract: paper.tldr,
    url: paper.forumUrl,
    sameAs: [paper.forumUrl, paper.pdfUrl, paper.iclrVirtualUrl, paper.githubUrl],
    inLanguage: 'en'
  })} />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://rishia.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Research',
        item: canonicalResearchUrl
      }
    ]
  })} />

  <main class="min-h-screen bg-codGray text-quillGray">
    <div class="max-w-4xl mx-auto px-4 md:px-8 py-12">

      <!-- Breadcrumbs -->
      <Breadcrumbs client:load items={breadcrumbs} />

      <!-- Page Header -->
      <header class="mb-10 mt-6">
        <h1 class="text-3xl md:text-4xl font-bold text-quillGray font-ptMono mb-3">Research</h1>
        <p class="text-sm md:text-base text-gunSmoke font-ptMono max-w-2xl leading-relaxed">
          Published work at the intersection of time-series forecasting, retrieval-augmented architectures, and foundation models.
        </p>
      </header>

      <!-- Conference notice -->
      <div class="mb-6 rounded-lg border border-accent/25 bg-accent/10 px-4 py-3">
        <p class="text-sm font-ptMono text-accent-light leading-relaxed">
          Poster presentation at <span class="font-semibold text-quillGray">ICLR 2026 Workshop (TSALM)</span> in {presentationDetails.city}, {presentationDetails.country} ({presentationDetails.workshopDatesLabel}). Received a {presentationDetails.grantLabel} travel grant.
        </p>
        <p class="mt-2 text-xs font-ptMono text-gunSmoke leading-relaxed">
          Verified details:
          <a href={presentationDetails.conferenceUrl} target="_blank" rel="noopener noreferrer" class="text-accent-light/80 hover:text-accent-light transition-colors">ICLR 2026 venue</a>,
          <a href={presentationDetails.conferenceDatesUrl} target="_blank" rel="noopener noreferrer" class="text-accent-light/80 hover:text-accent-light transition-colors">workshop dates</a>,
          and <a href={paper.forumUrl} target="_blank" rel="noopener noreferrer" class="text-accent-light/80 hover:text-accent-light transition-colors">paper forum</a>.
        </p>
      </div>

      <!-- Paper Card -->
      <article class="bg-bgShades-light border border-darkGrey/40 rounded-lg">
        <div class="p-6 md:p-8">
          <p class="text-xs font-ptMono text-gunSmoke mb-4">
            {paper.proceedings} · {paper.venue}
          </p>

          <!-- Title -->
          <h2 class="text-xl md:text-2xl font-bold text-quillGray font-ptMono leading-snug mb-5">
            {paper.title}
          </h2>

          <!-- Authors -->
          <div class="flex flex-wrap items-center gap-x-1 gap-y-1 mb-6 font-ptMono text-sm">
            {paper.authors.map((author, i) => (
              <>
                <a
                  href={author.profile}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`hover:text-accent-light transition-colors duration-200 ${author.isMe ? 'text-accent-light font-medium underline underline-offset-2 decoration-accent-light/40' : 'text-gunSmoke'}`}
                >
                  {author.name}
                </a>
                {i < paper.authors.length - 1 && (
                  <span class="text-darkGrey select-none">,</span>
                )}
              </>
            ))}
          </div>

          <!-- Published date -->
          <div class="border-t border-darkGrey/30 mb-6"></div>

          <!-- TL;DR -->
          <div class="mb-6 bg-bgShades-DEFAULT border border-accent/15 rounded-lg p-4">
            <p class="text-xs font-ptMono text-accent-light mb-1.5 uppercase tracking-wider">TL;DR</p>
            <p class="text-sm font-ptMono text-quillGray leading-relaxed">{paper.tldr}</p>
          </div>

          <!-- Abstract -->
          <div class="mb-6">
            <h3 class="text-xs font-ptMono text-gunSmoke uppercase tracking-wider mb-3">Abstract</h3>
            <p id="abstract-text" class="text-xs md:text-sm font-ptMono text-gunSmoke leading-relaxed max-h-36 md:max-h-none overflow-hidden md:overflow-visible transition-all duration-300">
              {paper.abstract}
            </p>
            <button
              id="toggle-abstract"
              type="button"
              class="mt-3 md:hidden inline-flex items-center gap-1 text-xs font-ptMono text-accent-light hover:text-accent transition-colors"
              aria-expanded="false"
              aria-controls="abstract-text"
            >
              <span id="toggle-abstract-label">Show more</span>
            </button>
          </div>

          <!-- Links -->
          <div class="flex flex-wrap gap-3 mb-8 pt-1">
            <a
              href={paper.forumUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-accent hover:bg-accent-light text-codGray font-ptMono text-sm font-medium rounded-lg transition-colors duration-200"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              OpenReview
            </a>
            <a
              href={paper.pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-bgShades-DEFAULT hover:bg-bgShades-lighter border border-darkGrey/40 hover:border-accent/30 text-quillGray font-ptMono text-sm rounded-lg transition-all duration-200"
            >
              <svg class="w-4 h-4 text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Paper PDF
            </a>
            <a
              href={paper.posterUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-bgShades-DEFAULT hover:bg-bgShades-lighter border border-darkGrey/40 hover:border-accent/30 text-quillGray font-ptMono text-sm rounded-lg transition-all duration-200"
            >
              <svg class="w-4 h-4 text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Poster
            </a>
          </div>

          <!-- Secondary links row -->
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-ptMono">
            <a
              href={paper.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-gunSmoke hover:text-accent-light transition-colors duration-200"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              Code & Data
            </a>
            <span class="text-darkGrey">·</span>
            <a
              href={paper.iclrVirtualUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-gunSmoke hover:text-accent-light transition-colors duration-200"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              ICLR Virtual
            </a>
            <span class="text-darkGrey">·</span>
            <a
              href={paper.tsalmUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-gunSmoke hover:text-accent-light transition-colors duration-200"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              TSALM Workshop
            </a>
          </div>

        </div>
      </article>

      <!-- BibTeX -->
      <div class="mt-8">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h3 class="text-xs font-ptMono text-gunSmoke uppercase tracking-wider">Cite</h3>
          <button
            id="copy-bibtex"
            class="px-2.5 py-1.5 bg-bgShades-light border border-darkGrey/40 rounded-md text-xs font-ptMono text-gunSmoke hover:text-accent-light hover:border-accent/30 transition-all duration-200"
            aria-label="Copy BibTeX"
          >
            <span id="copy-label">copy</span>
          </button>
          <span id="copy-status" class="sr-only" aria-live="polite"></span>
        </div>
        <div>
          <pre class="bg-bgShades-darker border border-darkGrey/40 rounded-lg p-4 text-xs font-ptMono text-gunSmoke leading-relaxed overflow-x-auto whitespace-pre-wrap break-words"><code id="bibtex-code">{paper.bibtex}</code></pre>
        </div>
      </div>

      <!-- Footer note -->
      <div class="mt-10 pt-8 border-t border-darkGrey/20">
        <p class="text-xs font-ptMono text-gunSmoke/60 leading-relaxed">
          Work done at <span class="text-gunSmoke">Dr. B.R. Ambedkar National Institute of Technology Jalandhar</span>. 
          Published under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer" class="text-accent-light/70 hover:text-accent-light transition-colors">CC BY 4.0</a>.
        </p>
      </div>

    </div>
  </main>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-bibtex');
  const copyLabel = document.getElementById('copy-label');
  const copyStatus = document.getElementById('copy-status');
  const bibtexCode = document.getElementById('bibtex-code');
  const abstractText = document.getElementById('abstract-text');
  const toggleAbstract = document.getElementById('toggle-abstract');
  const toggleAbstractLabel = document.getElementById('toggle-abstract-label');

  let isAbstractExpanded = false;

  if (toggleAbstract && abstractText && toggleAbstractLabel) {
    toggleAbstract.addEventListener('click', () => {
      isAbstractExpanded = !isAbstractExpanded;

      if (isAbstractExpanded) {
        abstractText.classList.remove('max-h-36', 'overflow-hidden');
        abstractText.classList.add('max-h-none', 'overflow-visible');
        toggleAbstractLabel.textContent = 'Show less';
        toggleAbstract.setAttribute('aria-expanded', 'true');
      } else {
        abstractText.classList.add('max-h-36', 'overflow-hidden');
        abstractText.classList.remove('max-h-none', 'overflow-visible');
        toggleAbstractLabel.textContent = 'Show more';
        toggleAbstract.setAttribute('aria-expanded', 'false');
      }
    });
  }

  if (copyBtn && copyLabel && copyStatus && bibtexCode) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(bibtexCode.textContent || '');
        copyLabel.textContent = 'copied!';
        copyStatus.textContent = 'BibTeX copied to clipboard.';
        copyBtn.classList.add('text-accent-light', 'border-accent/30');
        setTimeout(() => {
          copyLabel.textContent = 'copy';
          copyStatus.textContent = '';
          copyBtn.classList.remove('text-accent-light', 'border-accent/30');
        }, 2000);
      } catch {
        copyLabel.textContent = 'error';
        copyStatus.textContent = 'Unable to copy BibTeX.';
        setTimeout(() => {
          copyLabel.textContent = 'copy';
          copyStatus.textContent = '';
        }, 2000);
      }
    });
  }
</script>
