---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs';
import { researchPapers, type ResearchPaper } from '../data/research';

const breadcrumbs = [
  { label: 'Rishi', href: '/' },
  { label: 'Research' }
];

const canonicalResearchUrl = 'https://rishia.in/research';
const researchDescription = 'Research publications by Rishi Ahuja across time-series forecasting, retrieval-augmented models, and trustworthy conversational fraud detection.';

const toSchemaEvent = (paper: ResearchPaper) => {
  if (!paper.event) {
    return undefined;
  }

  const [city, country] = paper.event.location.split(',').map((part) => part.trim());

  return {
    '@type': 'Event',
    name: paper.event.venue,
    startDate: paper.event.startDate,
    endDate: paper.event.endDate,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: paper.event.location,
      address: {
        '@type': 'PostalAddress',
        addressLocality: city,
        addressCountry: country ?? city,
      },
    },
    url: paper.event.url,
  };
};

const toSchemaPaper = (paper: ResearchPaper) => {
  const schemaPaper: Record<string, unknown> = {
    '@type': paper.status === 'Published' ? 'ScholarlyArticle' : 'CreativeWork',
    headline: paper.title,
    author: paper.authors?.map((author) => ({
      '@type': 'Person',
      name: author.name,
      ...(author.profile ? { url: author.profile } : {}),
    })) ?? [{ '@type': 'Person', name: 'Rishi Ahuja' }],
    abstract: paper.tldr,
    url: paper.primaryUrl ?? canonicalResearchUrl,
    sameAs: paper.sameAs,
    inLanguage: 'en',
    ...(paper.event ? { isPartOf: toSchemaEvent(paper) } : {}),
    ...(paper.award ? { award: paper.award } : {}),
  };

  if (paper.status === 'Published' && paper.publishedIsoDate) {
    schemaPaper.datePublished = paper.publishedIsoDate;
  } else {
    schemaPaper.creativeWorkStatus = 'Accepted';
  }

  return schemaPaper;
};
---

<BaseLayout
  title="Research | Rishi Ahuja"
  description={researchDescription}
  image="/og?title=Research&description=ICLR%202026%20%C2%B7%20IJCAI-ECAI%202026&type=default"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Research | Rishi Ahuja',
    url: canonicalResearchUrl,
    description: researchDescription,
    hasPart: researchPapers.map(toSchemaPaper),
  })} />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://rishia.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Research',
        item: canonicalResearchUrl
      }
    ]
  })} />

  <main class="min-h-screen bg-codGray text-quillGray">
    <div class="max-w-4xl mx-auto px-4 md:px-8 py-12">
      <Breadcrumbs client:load items={breadcrumbs} />

      <header class="mb-10 mt-6">
        <h1 class="text-3xl md:text-4xl font-bold text-quillGray font-ptMono mb-3">Research</h1>
        <p class="text-sm md:text-base text-gunSmoke font-ptMono max-w-3xl leading-relaxed">
          Recent work across time-series forecasting, retrieval-augmented systems, and trustworthy conversational fraud detection.
          I presented at ICLR 2026 in Rio de Janeiro in April, and I will be presenting at IJCAI-ECAI 2026 in Bremen this August.
        </p>
      </header>

      <div class="space-y-6">
        {researchPapers.map((paper) => (
          <article class="bg-bgShades-light border border-darkGrey/40 rounded-lg">
            <div class="p-6 md:p-8">
              <div class="flex flex-wrap items-center gap-3 mb-4">
                <span class={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-ptMono uppercase tracking-wider border ${
                  paper.status === 'Accepted'
                    ? 'border-accent/30 bg-accent/10 text-accent-light'
                    : 'border-darkGrey/40 bg-bgShades-DEFAULT text-gunSmoke'
                }`}>
                  {paper.status}
                </span>
                <span class="text-xs font-ptMono text-gunSmoke">{paper.statusLabel}</span>
              </div>

              <p class="text-xs font-ptMono text-gunSmoke mb-4">
                {paper.proceedings} · {paper.venue}
              </p>

              <h2 class="text-xl md:text-2xl font-bold text-quillGray font-ptMono leading-snug mb-5">
                {paper.title}
              </h2>

              {paper.authors ? (
                <>
                  <div class="flex flex-wrap items-center gap-x-1 gap-y-1 mb-2 font-ptMono text-sm">
                    {paper.authors.map((author, index) => (
                      <span class="contents">
                        <a
                          href={author.profile}
                          target="_blank"
                          rel="noopener noreferrer"
                          class={`hover:text-accent-light transition-colors duration-200 ${
                            author.isMe
                              ? 'text-accent-light font-medium underline underline-offset-2 decoration-accent-light/40'
                              : 'text-gunSmoke'
                          }`}
                        >
                          {author.name}<sup class="text-[0.6em] text-gunSmoke/70 ml-px">†{author.isCorresponding ? '✉' : ''}</sup>
                        </a>
                        {index < (paper.authors ?? []).length - 1 && (
                          <span class="text-darkGrey select-none">,</span>
                        )}
                      </span>
                    ))}
                  </div>
                  {paper.affiliationNote && (
                    <p class="text-xs font-ptMono text-gunSmoke/60 mb-6 leading-relaxed">
                      <sup class="text-[0.6em]">†</sup>{paper.affiliationNote}
                    </p>
                  )}
                </>
              ) : (
                <div class="mb-6">
                  <p class="text-sm font-ptMono text-accent-light">{paper.authorsDisplay}</p>
                  {paper.affiliationNote && (
                    <p class="mt-2 text-xs font-ptMono text-gunSmoke/70 leading-relaxed">
                      {paper.affiliationNote}
                    </p>
                  )}
                </div>
              )}

              {paper.event && (
                <div class="mb-6 rounded-lg border border-accent/20 bg-accent/10 p-4">
                  <p class="text-sm font-ptMono text-accent-light leading-relaxed">
                    {paper.event.label} <span class="font-semibold text-quillGray">{paper.event.venue}</span> in {paper.event.location} ({paper.event.datesLabel}).
                    {paper.award && ` Received a ${paper.award}.`}
                  </p>
                  {paper.event.verifiedLinks?.length ? (
                    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-ptMono text-gunSmoke">
                      {paper.event.verifiedLinks.map((link) => (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-accent-light/80 hover:text-accent-light transition-colors"
                        >
                          {link.label}
                        </a>
                      ))}
                    </div>
                  ) : null}
                </div>
              )}

              <div class="mb-6 bg-bgShades-DEFAULT border border-accent/15 rounded-lg p-4">
                <p class="text-xs font-ptMono text-accent-light mb-1.5 uppercase tracking-wider">TL;DR</p>
                <p class="text-sm font-ptMono text-quillGray leading-relaxed">{paper.tldr}</p>
              </div>

              <div class="mb-6">
                <h3 class="text-xs font-ptMono text-gunSmoke uppercase tracking-wider mb-3">Abstract</h3>
                <p class="text-xs md:text-sm font-ptMono text-gunSmoke leading-relaxed">
                  {paper.abstract}
                </p>
              </div>

              {paper.links.length ? (
                <div class="flex flex-wrap gap-3 pt-1">
                  {paper.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={`inline-flex items-center gap-2 px-4 py-2 font-ptMono text-sm rounded-lg transition-all duration-200 ${
                        link.primary
                          ? 'bg-accent hover:bg-accent-light text-codGray font-medium'
                          : 'bg-bgShades-DEFAULT hover:bg-bgShades-lighter border border-darkGrey/40 hover:border-accent/30 text-quillGray'
                      }`}
                    >
                      <svg class={`w-4 h-4 ${link.primary ? '' : 'text-accent-light'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                      {link.label}
                    </a>
                  ))}
                </div>
              ) : null}

              {paper.bibtex && (
                <div class="mt-8">
                  <div class="mb-3 flex items-center justify-between gap-3">
                    <h3 class="text-xs font-ptMono text-gunSmoke uppercase tracking-wider">Cite</h3>
                    <button
                      data-copy-bibtex={paper.slug}
                      class="px-2.5 py-1.5 bg-bgShades-light border border-darkGrey/40 rounded-md text-xs font-ptMono text-gunSmoke hover:text-accent-light hover:border-accent/30 transition-all duration-200"
                      aria-label={`Copy BibTeX for ${paper.title}`}
                    >
                      <span data-copy-label={paper.slug}>copy</span>
                    </button>
                  </div>
                  <pre class="bg-bgShades-darker border border-darkGrey/40 rounded-lg p-4 text-xs font-ptMono text-gunSmoke leading-relaxed overflow-x-auto whitespace-pre-wrap break-words"><code id={`bibtex-${paper.slug}`}>{paper.bibtex}</code></pre>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="mt-10 pt-8 border-t border-darkGrey/20">
        <p class="text-xs font-ptMono text-gunSmoke/60 leading-relaxed">
          Work done at <span class="text-gunSmoke">Dr. B.R. Ambedkar National Institute of Technology Jalandhar</span>.
          Public artifacts are linked whenever available; accepted papers may briefly remain metadata-only until camera-ready release.
        </p>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const copyButtons = document.querySelectorAll('[data-copy-bibtex]');

  copyButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const slug = button.getAttribute('data-copy-bibtex');
      const code = slug ? document.getElementById(`bibtex-${slug}`) : null;
      const label = slug ? document.querySelector(`[data-copy-label="${slug}"]`) : null;

      if (!slug || !code || !label) {
        return;
      }

      try {
        await navigator.clipboard.writeText(code.textContent || '');
        label.textContent = 'copied!';
        button.classList.add('text-accent-light', 'border-accent/30');
        setTimeout(() => {
          label.textContent = 'copy';
          button.classList.remove('text-accent-light', 'border-accent/30');
        }, 2000);
      } catch {
        label.textContent = 'error';
        setTimeout(() => {
          label.textContent = 'copy';
        }, 2000);
      }
    });
  });
</script>
