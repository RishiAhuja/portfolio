---
import GalleryLayout from '../layouts/GalleryLayout.astro';
import { getAllGalleryCollections } from '../lib/gallery';
import { frameCount, isVideoUrl, resized, rollName, rollStamp, shareImage, sortRolls } from '../lib/galleryFrames';

const rolls = sortRolls(await getAllGalleryCollections());
const years = [...new Set(rolls.map((roll) => roll.year))];
const totalFrames = rolls.reduce((sum, roll) => sum + (roll.image_count ?? 0), 0);
---

<GalleryLayout
  title="Gallery · Rishi Ahuja"
  description="Photos from trips, conferences, and ordinary days, kept a roll a month."
  image={shareImage(rolls.map((roll) => roll.cover_image_url))}
>
  <section class="gallery-intro wrap">
    <h1>Gallery</h1>
    <p class="gallery-lede">Trips, conferences, and ordinary days, kept a roll a month. {rolls.length > 0 && <>{rolls.length} rolls, {totalFrames} frames.</>}</p>
  </section>

  <div class="wrap">
    {rolls.length === 0 ? (
      <p class="empty-state">The first roll is still being developed.</p>
    ) : years.map((year) => (
      <section class="roll-year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>
        <ul class="rolls">
          {rolls.filter((roll) => roll.year === year).map((roll) => (
            <li class="roll">
              <a href={`/gallery/${roll.slug}`}>
                <div class="roll-cover">
                  {roll.cover_image_url && (isVideoUrl(roll.cover_image_url) ? (
                    // The #t fragment makes browsers paint a frame instead of black.
                    <video src={`${roll.cover_image_url}#t=0.5`} muted playsinline preload="metadata" aria-hidden="true" tabindex="-1" />
                  ) : (
                    <img src={resized(roll.cover_image_url, 640)} alt="" width="640" height="800" loading="lazy" decoding="async" />
                  ))}
                  <span class="stamp" aria-hidden="true">{rollStamp(roll)}</span>
                </div>
                <p class="roll-name">{rollName(roll)}</p>
                <p class="roll-meta">{frameCount(roll.image_count ?? 0)}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</GalleryLayout>
