---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllGalleryEvents } from '../lib/gallery';

const allEvents = await getAllGalleryEvents('');

// Sort events by date (newest first)
const sortedEvents = allEvents.sort((a, b) => 
  new Date(b.event_date).getTime() - new Date(a.event_date).getTime()
);

// Format date
function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const month = months[date.getMonth()];
  const day = date.getDate().toString().padStart(2, '0');
  const year = date.getFullYear();
  return `${day} ${month} ${year}`;
}
---

<BaseLayout 
  title="Artifacts | Rishi Ahuja"
  description="Image archive"
>
  <style>
    .gallery-container {
      font-family: 'PT Mono', monospace;
      background: var(--codGray);
      color: var(--quillGray);
      min-height: 100vh;
      padding: 2rem;
    }
    
    .gallery-header {
      max-width: 1200px;
      margin: 0 auto 3rem;
    }
    
    .gallery-title {
      font-size: 2rem;
      font-weight: 600;
      color: var(--quillGray);
      margin-bottom: 0.5rem;
    }
    
    .gallery-subtitle {
      color: var(--gunSmoke);
      font-size: 0.9rem;
    }
    
    .gallery-listing {
      max-width: 1200px;
      margin: 0 auto;
    }
    
    .event-row {
      display: block;
      text-decoration: none;
      border-bottom: 1px solid rgba(var(--gunSmoke-rgb), 0.15);
      transition: all 0.2s ease;
    }
    
    .event-header {
      display: grid;
      grid-template-columns: 110px 1fr auto;
      gap: 1.5rem;
      padding: 1.25rem 0;
      cursor: pointer;
      align-items: center;
    }
    
    .event-row:hover .event-header {
      background: rgba(var(--darkGrey-rgb), 0.2);
      border-left: 2px solid var(--accent-light);
      padding-left: calc(1rem - 2px);
    }
    
    .event-date {
      color: var(--gunSmoke);
      font-size: 0.85rem;
    }
    
    .event-info {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }
    
    .event-title {
      color: var(--quillGray);
      font-size: 1rem;
      font-weight: 500;
    }
    
    .event-location {
      color: var(--gunSmoke);
      font-size: 0.8rem;
    }
    
    .event-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      color: var(--gunSmoke);
      font-size: 0.85rem;
    }
    
    .category-badge {
      font-size: 0.7rem;
      padding: 0.2rem 0.5rem;
      border: 1px solid var(--gunSmoke);
      color: var(--gunSmoke);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    
    .image-count {
      color: var(--gunSmoke);
    }
    
    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--gunSmoke);
    }
    
    @media (max-width: 768px) {
      .event-header {
        grid-template-columns: 90px 1fr;
        gap: 1rem;
      }
      
      .event-meta {
        display: none;
      }
      
      .images-grid {
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 0.75rem;
      }
    }
  </style>

  <main class="gallery-container">
    <header class="gallery-header">
      <h1 class="gallery-title">Artifacts</h1>
      <p class="gallery-subtitle">
        {sortedEvents.length} {sortedEvents.length === 1 ? 'event' : 'events'}
      </p>
    </header>

    {allEvents.length > 0 ? (
      <div class="gallery-listing">
        {sortedEvents.map((event) => (
          <a href={`/gallery/${event.slug}`} class="event-row" data-event-id={event.id}>
            <div class="event-header">
              <span class="event-date">{formatDate(event.event_date)}</span>
              <div class="event-info">
                <span class="event-title">{event.title}</span>
                {event.location && (
                  <span class="event-location">{event.location}</span>
                )}
              </div>
              <div class="event-meta">
                <span class="category-badge">{event.category}</span>
                <span class="image-count">{event.image_count || 0} photos</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h2>No events yet</h2>
        <p>Check back soon.</p>
      </div>
    )}
  </main>
</BaseLayout>
