---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs';
import { getBootcampLectures, type BootcampLecture } from '../lib/admin';
import { getBootcampStudents, getStudentCount } from '../lib/bootcamp-students';
import { LINKS } from '../lib/constants';

const lectures = await getBootcampLectures();
const totalLectures = lectures.length;
const students = getBootcampStudents();
const studentCount = getStudentCount();

const breadcrumbs = [
  { label: 'Rishi', href: '/' },
  { label: 'Community', href: '/community' },
  { label: 'CS404: Applied Mobile Engineering' }
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const courseStartDate = "2024-12-01";
const courseEndDate = "2025-01-20";
const instructorName = "Rishi Ahuja";
const totalDuration = "PT23H"; // ISO 8601 duration format
---

<BaseLayout 
  title="CS404: Applied Mobile Engineering - Flutter Bootcamp | Rishi Ahuja"
  description="Comprehensive Flutter mobile development bootcamp with 23+ hours of production-ready content. Master Flutter, Dart, state management (BLoC, Provider), UI/UX design, API integration, and deploy production apps. Complete course for mobile engineers."
  image="/og/flutter-bootcamp.png"
>
  <!-- Enhanced Meta Tags -->
  <meta slot="head" name="keywords" content="flutter bootcamp, flutter course, mobile development, dart programming, flutter tutorial, app development, cross-platform development, flutter training, mobile engineering, flutter state management, bloc pattern, provider flutter, flutter UI, mobile app development course, learn flutter, flutter certification, production flutter apps" />
  <meta slot="head" name="author" content="{instructorName}" />
  <meta slot="head" name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link slot="head" rel="canonical" href={canonicalURL.href} />
  
  <!-- Open Graph / Facebook -->
  <meta slot="head" property="og:type" content="website" />
  <meta slot="head" property="og:url" content={canonicalURL.href} />
  <meta slot="head" property="og:title" content="CS404: Applied Mobile Engineering - Complete Flutter Development Bootcamp" />
  <meta slot="head" property="og:description" content="Master Flutter development in 23+ hours. From fundamentals to production-ready apps. Learn state management, architecture patterns, and deploy real-world applications." />
  <meta slot="head" property="og:image" content={new URL('/og/flutter-bootcamp.png', Astro.site).href} />
  <meta slot="head" property="og:image:width" content="1200" />
  <meta slot="head" property="og:image:height" content="630" />
  <meta slot="head" property="og:locale" content="en_US" />
  <meta slot="head" property="og:site_name" content="Rishi Ahuja" />
  
  <!-- Twitter -->
  <meta slot="head" name="twitter:card" content="summary_large_image" />
  <meta slot="head" name="twitter:url" content={canonicalURL.href} />
  <meta slot="head" name="twitter:title" content="CS404: Applied Mobile Engineering - Flutter Bootcamp" />
  <meta slot="head" name="twitter:description" content="23+ hours of Flutter development training. Master mobile engineering with hands-on projects and production-ready skills." />
  <meta slot="head" name="twitter:image" content={new URL('/og/flutter-bootcamp.png', Astro.site).href} />
  <meta slot="head" name="twitter:creator" content="@Rishi2220" />
  
  <!-- Structured Data - Course Schema -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "CS404: Applied Mobile Engineering",
    "description": "Comprehensive Flutter mobile development bootcamp covering fundamentals to advanced production-ready app development. Learn Dart, state management, UI/UX design, and deployment.",
    "provider": {
      "@type": "Person",
      "name": instructorName,
      "url": "https://rishia.in"
    },
    "instructor": {
      "@type": "Person",
      "name": instructorName,
      "jobTitle": "Mobile Developer & Instructor",
      "url": "https://rishia.in"
    },
    "url": canonicalURL.href,
    "courseCode": "CS404",
    "educationalLevel": "Intermediate to Advanced",
    "teaches": [
      "Flutter Framework",
      "Dart Programming",
      "Mobile App Development",
      "State Management (BLoC, Provider)",
      "Clean Architecture",
      "API Integration",
      "UI/UX Design",
      "App Deployment"
    ],
    "timeRequired": totalDuration,
    "numberOfLectures": totalLectures,
    "coursePrerequisites": "Basic programming knowledge",
    "inLanguage": "en",
    "availableLanguage": ["en"],
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseMode": "online",
      "courseWorkload": totalDuration,
      "startDate": courseStartDate,
      "endDate": courseEndDate
    },
    "offers": {
      "@type": "Offer",
      "category": "Free",
      "availability": "https://schema.org/OnlineOnly"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.8",
      "ratingCount": "10",
      "bestRating": "5"
    }
  })} />
  
  <!-- Breadcrumb Structured Data -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://rishia.in/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Community",
        "item": "https://rishia.in/community"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "CS404: Applied Mobile Engineering",
        "item": canonicalURL.href
      }
    ]
  })} />
  
  <!-- FAQ Structured Data -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What will I learn in this Flutter bootcamp?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You'll learn Flutter fundamentals, Dart programming, state management, API integration, UI/UX design patterns, and production app deployment. The course includes 23+ hours of comprehensive content with hands-on projects."
        }
      },
      {
        "@type": "Question",
        "name": "Is this course suitable for beginners?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "This bootcamp is designed for intermediate to advanced learners. Basic programming knowledge is recommended. We start with Flutter fundamentals and progress to advanced production-ready concepts."
        }
      },
      {
        "@type": "Question",
        "name": "How long is the course?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The complete bootcamp contains 23+ hours of video content, slides, and additional resources. Students typically complete it over 4-6 weeks with hands-on practice."
        }
      },
      {
        "@type": "Question",
        "name": "What projects will I build?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Students build production-ready mobile applications including chat apps, API-integrated platforms, and apps with advanced state management. Each project reinforces Flutter development best practices."
        }
      }
    ]
  })} />
  <main class="min-h-screen bg-codGray py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Breadcrumbs -->
      <Breadcrumbs client:load items={breadcrumbs} />
      
      <!-- Header -->
      <header class="text-center mb-12">
        <div class="flex items-center justify-center gap-3 mb-3">
          <h1 class="text-3xl md:text-4xl font-bold text-quillGray font-ptMono">
            CS404: Applied Mobile Engineering - Flutter Development Bootcamp
          </h1>
        </div>
        <p class="text-base text-gunSmoke font-ptMono mb-4">
          23+ hours of comprehensive Flutter content. The missing semester of mobile engineering.
        </p>
        
        <!-- Download Curriculum PDF -->
        <a
          href={LINKS.FLUTTER_BOOTCAMP_CURRICULUM}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-darkGrey/30 border border-gunSmoke/40 rounded-sm text-quillGray hover:border-accent-light/50 hover:text-accent-light transition-all duration-200 font-ptMono text-sm mt-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>View Complete Curriculum</span>
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"></path>
            <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"></path>
          </svg>
        </a>
      </header>

      <!-- Lectures Grid -->
      <section aria-labelledby="course-lectures">
        <h2 id="course-lectures" class="text-2xl font-bold text-quillGray font-ptMono mb-6">Course Lectures</h2>
      {totalLectures === 0 ? (
        <div class="text-center py-20">
          <div class="inline-block p-8 bg-darkGrey/20 rounded-lg">
            <svg class="w-16 h-16 text-gunSmoke mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            <p class="text-gunSmoke font-ptMono text-lg">
              No lectures published yet
            </p>
            <p class="text-gunSmoke/60 font-ptMono text-sm mt-2">
              Check back soon for new content!
            </p>
          </div>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 gap-4">
          {lectures.map((lecture: BootcampLecture) => (
            <div 
              class="group bg-darkGrey/20 border border-darkGrey/50 rounded-lg p-5 hover:border-accent-light/30 hover:shadow-lg hover:shadow-accent-light/5 transition-all duration-300 hover:-translate-y-1 flex flex-col"
              data-lecture-id={lecture.id}
            >
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <span class="inline-block px-2.5 py-1 bg-accent-light/10 text-accent-light rounded text-xs font-ptMono font-bold">
                    Day {lecture.day_number}
                  </span>
                </div>
                <h2 class="text-base md:text-lg font-bold text-quillGray mb-2 font-ptMono group-hover:text-accent-light transition-colors">
                  {lecture.title}
                </h2>
                {lecture.description && (
                  <p class="text-gunSmoke font-ptMono text-xs leading-relaxed line-clamp-2 mb-4">
                    {lecture.description}
                  </p>
                )}
              </div>

              <!-- Resources -->
              <div class="flex gap-2 mt-auto">
                {lecture.video_url && (
                  <a 
                    href={lecture.video_url}
                    target="_blank"
                    rel="noopener noreferrer" 
                    title="Watch Video"
                    class="flex items-center justify-center w-10 h-10 bg-red-500/10 border border-red-500/40 rounded-lg text-red-400 hover:bg-red-500 hover:text-white hover:scale-110 transition-all duration-200 shadow-sm hover:shadow-red-500/20"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"></path>
                    </svg>
                  </a>
                )}
                
                {lecture.slides_url && (
                  <a 
                    href={lecture.slides_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Download Slides"
                    class="flex items-center justify-center w-10 h-10 bg-accent-light/10 border border-accent-light/40 rounded-lg text-accent-light hover:bg-accent-light hover:text-codGray hover:scale-110 transition-all duration-200 shadow-sm hover:shadow-accent-light/20"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                    </svg>
                  </a>
                )}
              </div>

              {/* Additional Resources */}
              {lecture.additional_resources && lecture.additional_resources.length > 0 && (
                <div class="mt-3 pt-3 border-t border-darkGrey/50">
                  <p class="text-[10px] text-gunSmoke font-ptMono mb-2 flex items-center gap-1.5">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"></path>
                    </svg>
                    Additional Resources:
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {lecture.additional_resources.map((resource, index) => (
                      <a
                        href={resource.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-3 py-1 bg-darkGrey/40 border border-gunSmoke/20 rounded text-gunSmoke hover:text-accent-light hover:border-accent-light/40 transition-all duration-200 font-ptMono text-xs"
                      >
                        {resource.label}
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"></path>
                          <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"></path>
                        </svg>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      )}
      </section>

      <!-- Students Section -->
      <div class="mt-16 mb-8">
        <div class="text-center mb-6">
          <button
            id="toggleStudents"
            class="inline-flex items-center gap-2 px-4 py-2 bg-darkGrey/30 border border-gunSmoke/40 rounded-sm text-quillGray hover:border-accent-light/50 hover:text-accent-light transition-all duration-200 font-ptMono text-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span>View Attendees</span>
            <svg id="studentsChevron" class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>

        <div id="studentsSection" class="hidden">
          <div class="bg-darkGrey/20 border border-darkGrey/50 rounded-lg p-6">
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-xl font-bold text-quillGray font-ptMono">Course Participants</h2>
              <span class="text-sm text-gunSmoke font-ptMono">{studentCount} students</span>
            </div>
            
            <div class="grid md:grid-cols-2 gap-3">
              {students.filter(s => s.consent).map((student) => (
                <div class="bg-codGray/30 rounded p-3 border border-darkGrey/30 hover:border-accent-light/20 transition-colors group">
                  <div class="flex items-start gap-3">
                    <a 
                      href={student.linkedinProfile}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-10 h-10 rounded-full bg-accent-light/10 flex items-center justify-center text-accent-light font-ptMono font-bold text-sm flex-shrink-0 hover:bg-accent-light hover:text-codGray transition-all duration-200"
                      title={`View ${student.name}'s LinkedIn profile`}
                    >
                      {student.initials}
                    </a>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        <h3 class="text-sm font-bold text-quillGray font-ptMono truncate">
                          {student.name}
                        </h3>
                        {student.linkedinPost && (
                          <a
                            href={student.linkedinPost}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex-shrink-0 text-accent-light/60 hover:text-accent-light transition-colors"
                            title="View bootcamp post"
                          >
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                              <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"></path>
                              <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"></path>
                            </svg>
                          </a>
                        )}
                      </div>
                      <div class="flex items-center gap-2">
                        <a
                          href={student.linkedinProfile}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-xs text-gunSmoke/80 hover:text-accent-light font-ptMono transition-colors inline-flex items-center gap-1"
                        >
                          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                          </svg>
                          LinkedIn Profile
                        </a>
                        {student.linkedinPost && (
                          <span class="text-gunSmoke/40">•</span>
                        )}
                        {student.linkedinPost && (
                          <a
                            href={student.linkedinPost}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-xs text-gunSmoke/80 hover:text-accent-light font-ptMono transition-colors"
                          >
                            Bootcamp Post
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Note -->
      <div class="mt-16 text-center">
        <p class="text-sm text-gunSmoke/60 font-ptMono">
          CS404: Applied Mobile Engineering was successfully completed with 23+ hours of comprehensive content.
        </p>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  // Toggle students section
  const toggleStudentsBtn = document.getElementById('toggleStudents');
  const studentsSection = document.getElementById('studentsSection');
  const studentsChevron = document.getElementById('studentsChevron');

  toggleStudentsBtn?.addEventListener('click', () => {
    const isHidden = studentsSection?.classList.contains('hidden');
    
    if (isHidden) {
      studentsSection?.classList.remove('hidden');
      studentsChevron?.classList.add('rotate-180');
      toggleStudentsBtn.querySelector('span')!.textContent = 'Hide Students';
    } else {
      studentsSection?.classList.add('hidden');
      studentsChevron?.classList.remove('rotate-180');
      toggleStudentsBtn.querySelector('span')!.textContent = 'View Students';
    }
  });
</script>

<style>
  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #1a1a1a;
  }

  ::-webkit-scrollbar-thumb {
    background: #333;
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #444;
  }
</style>
