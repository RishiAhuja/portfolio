---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs';

export async function getStaticPaths() {
  const papers = await getCollection('research');

  return papers.map((paper) => ({
    params: { slug: paper.slug },
    props: { paper },
  }));
}

const { paper } = Astro.props as { paper: CollectionEntry<'research'> };
const { Content } = await render(paper);

const allPapers = (await getCollection('research')).sort(
  (a, b) => b.data.sort_date.getTime() - a.data.sort_date.getTime()
);

const relatedPapers = allPapers.filter((entry) => entry.slug !== paper.slug).slice(0, 2);
const pageUrl = `https://rishia.in/research/${paper.slug}`;
const pageDescription = paper.data.description;

const breadcrumbs = [
  { label: 'Rishi', href: '/' },
  { label: 'Research', href: '/research' },
  { label: paper.data.title }
];

const [city, country] = paper.data.event?.location.split(',').map((part) => part.trim()) ?? [];
---

<BaseLayout
  title={`${paper.data.title} | Rishi Ahuja`}
  description={pageDescription}
  image={`/og?title=${encodeURIComponent(paper.data.title)}&description=${encodeURIComponent(paper.data.description)}&type=default`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': paper.data.status === 'published' ? 'ScholarlyArticle' : 'CreativeWork',
    headline: paper.data.title,
    description: paper.data.description,
    author: paper.data.authors.map((author) => ({
      '@type': 'Person',
      name: author.name,
      ...(author.profile ? { url: author.profile } : {}),
    })),
    ...(paper.data.status === 'published' && paper.data.published_date
      ? { datePublished: paper.data.published_date.toISOString().split('T')[0] }
      : { creativeWorkStatus: 'Accepted' }),
    ...(paper.data.event ? {
      isPartOf: {
        '@type': 'Event',
        name: paper.data.event.venue,
        startDate: paper.data.event.start_date,
        endDate: paper.data.event.end_date,
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        location: {
          '@type': 'Place',
          name: paper.data.event.location,
          address: {
            '@type': 'PostalAddress',
            addressLocality: city,
            addressCountry: country ?? city,
          },
        },
        url: paper.data.event.url,
      }
    } : {}),
    ...(paper.data.award ? { award: paper.data.award } : {}),
    abstract: paper.data.abstract,
    url: pageUrl,
    sameAs: paper.data.same_as,
    inLanguage: 'en',
  })} />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://rishia.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Research',
        item: 'https://rishia.in/research'
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: paper.data.title,
        item: pageUrl
      }
    ]
  })} />

  <main class="min-h-screen bg-codGray text-quillGray">
    <div class="max-w-4xl mx-auto px-4 md:px-8 py-12">
      <Breadcrumbs items={breadcrumbs} />

      <article class="mt-8 bg-bgShades-light border border-darkGrey/40 rounded-lg">
        <div class="p-6 md:p-8">
          <p class="text-xs font-ptMono text-gunSmoke mb-4">
            {paper.data.proceedings} · {paper.data.venue}
          </p>

          <h1 class="text-2xl md:text-3xl font-bold text-quillGray font-ptMono leading-snug mb-5">
            {paper.data.title}
          </h1>

          <div class="flex flex-wrap items-center gap-x-1 gap-y-1 mb-2 font-ptMono text-sm">
            {paper.data.authors.map((author, index) => (
              <span class="contents">
                <a
                  href={author.profile}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`hover:text-accent-light transition-colors duration-200 ${
                    author.is_me
                      ? 'text-accent-light font-medium underline underline-offset-2 decoration-accent-light/40'
                      : 'text-gunSmoke'
                  }`}
                >
                  {author.name}<sup class="text-[0.6em] text-gunSmoke/70 ml-px">†{author.is_corresponding ? '✉' : ''}</sup>
                </a>
                {index < paper.data.authors.length - 1 && (
                  <span class="text-darkGrey select-none">,</span>
                )}
              </span>
            ))}
          </div>

          {paper.data.affiliation_note && (
            <p class="text-xs font-ptMono text-gunSmoke/60 mb-6 leading-relaxed">
              <sup class="text-[0.6em]">†</sup>{paper.data.affiliation_note}
            </p>
          )}

          {paper.data.event && (
            <div class="mb-6 rounded-lg border border-accent/20 bg-accent/10 p-4">
              <p class="text-sm font-ptMono text-accent-light leading-relaxed">
                {paper.data.event.announcement}
              </p>
              {paper.data.event.verified_links.length ? (
                <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-ptMono text-gunSmoke">
                  {paper.data.event.verified_links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-accent-light/80 hover:text-accent-light transition-colors"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              ) : null}
            </div>
          )}

          <div class="mb-6 bg-bgShades-DEFAULT border border-accent/15 rounded-lg p-4">
            <p class="text-xs font-ptMono text-accent-light mb-1.5 uppercase tracking-wider">TL;DR</p>
            <p class="text-sm font-ptMono text-quillGray leading-relaxed">{paper.data.tldr}</p>
          </div>

          <div class="mb-6">
            <h2 class="text-xs font-ptMono text-gunSmoke uppercase tracking-wider mb-3">Abstract</h2>
            <p class="text-xs md:text-sm font-ptMono text-gunSmoke leading-relaxed">
              {paper.data.abstract}
            </p>
          </div>

          {paper.data.links.length ? (
            <div class="flex flex-wrap gap-3 mb-8">
              {paper.data.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`inline-flex items-center gap-2 px-4 py-2 font-ptMono text-sm rounded-lg transition-all duration-200 ${
                    link.primary
                      ? 'bg-accent hover:bg-accent-light text-codGray font-medium'
                      : 'bg-bgShades-DEFAULT hover:bg-bgShades-lighter border border-darkGrey/40 hover:border-accent/30 text-quillGray'
                  }`}
                >
                  <svg class={`w-4 h-4 ${link.primary ? '' : 'text-accent-light'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  {link.label}
                </a>
              ))}
            </div>
          ) : null}

          <div
            class="prose prose-invert max-w-none font-ptMono text-quillGray
              prose-headings:font-ptMono prose-headings:text-quillGray
              prose-p:text-quillGray prose-p:leading-relaxed
              prose-a:text-accent-light prose-a:no-underline hover:prose-a:underline
              prose-code:text-accent-light prose-code:bg-darkGrey/40 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
              prose-pre:bg-darkGrey/40 prose-pre:border prose-pre:border-darkGrey
              prose-ul:text-quillGray prose-ol:text-quillGray
              prose-li:text-quillGray prose-li:marker:text-accent-light
              prose-strong:text-quillGray prose-strong:font-bold
              prose-blockquote:text-gunSmoke prose-blockquote:border-l-accent-light"
          >
            <Content />
          </div>

          {paper.data.bibtex && (
            <div class="mt-8">
              <div class="mb-3 flex items-center justify-between gap-3">
                <h2 class="text-xs font-ptMono text-gunSmoke uppercase tracking-wider">Cite</h2>
                <button
                  id="copy-bibtex"
                  class="px-2.5 py-1.5 bg-bgShades-light border border-darkGrey/40 rounded-md text-xs font-ptMono text-gunSmoke hover:text-accent-light hover:border-accent/30 transition-all duration-200"
                  aria-label={`Copy BibTeX for ${paper.data.title}`}
                >
                  <span id="copy-label">copy</span>
                </button>
              </div>
              <pre class="bg-bgShades-darker border border-darkGrey/40 rounded-lg p-4 text-xs font-ptMono text-gunSmoke leading-relaxed overflow-x-auto whitespace-pre-wrap break-words"><code id="bibtex-code">{paper.data.bibtex}</code></pre>
            </div>
          )}
        </div>
      </article>

      {relatedPapers.length > 0 && (
        <section class="mt-10">
          <h2 class="text-sm font-ptMono text-gunSmoke uppercase tracking-wider mb-4">More Research</h2>
          <div class="grid gap-4 md:grid-cols-2">
            {relatedPapers.map((entry) => (
              <a
                href={`/research/${entry.slug}`}
                class="block rounded-lg border border-darkGrey/40 bg-bgShades-light p-5 hover:border-accent-light/40 transition-all duration-300"
              >
                <p class="text-xs font-ptMono text-accent-light/80 mb-2">
                  {entry.data.proceedings}
                </p>
                <h3 class="text-sm md:text-base font-ptMono font-medium text-quillGray leading-snug mb-2">
                  {entry.data.title}
                </h3>
                <p class="text-xs font-ptMono text-gunSmoke leading-relaxed">
                  {entry.data.description}
                </p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>

{paper.data.bibtex && (
  <script>
    const copyBtn = document.getElementById('copy-bibtex');
    const copyLabel = document.getElementById('copy-label');
    const bibtexCode = document.getElementById('bibtex-code');

    if (copyBtn && copyLabel && bibtexCode) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bibtexCode.textContent || '');
          copyLabel.textContent = 'copied!';
          copyBtn.classList.add('text-accent-light', 'border-accent/30');
          setTimeout(() => {
            copyLabel.textContent = 'copy';
            copyBtn.classList.remove('text-accent-light', 'border-accent/30');
          }, 2000);
        } catch {
          copyLabel.textContent = 'error';
          setTimeout(() => {
            copyLabel.textContent = 'copy';
          }, 2000);
        }
      });
    }
  </script>
)}
