---
import '../../styles/globals.css';
import Breadcrumbs from '../../components/ui/Breadcrumbs';
import { getGalleryCollectionBySlug, getAllGalleryCollections, type GalleryCollectionWithImages } from '../../lib/gallery';

export async function getStaticPaths() {
  const collections = await getAllGalleryCollections();
  return collections.map((collection) => ({
    params: { slug: collection.slug },
  }));
}

const { slug } = Astro.params;
const collectionData = await getGalleryCollectionBySlug(slug);

if (!collectionData) {
  return Astro.redirect('/gallery');
}

const collection: GalleryCollectionWithImages = collectionData;

// Get all collections to determine prev/next
const allCollections = await getAllGalleryCollections();
const currentIndex = allCollections.findIndex(c => c.slug === slug);
// Collections are sorted DESC (newest first), so:
// - "next" in time = previous in array (older collection)
// - "prev" in time = next in array (newer collection)
const nextCollection = currentIndex > 0 ? allCollections[currentIndex - 1] : null; // Newer
const prevCollection = currentIndex < allCollections.length - 1 ? allCollections[currentIndex + 1] : null; // Older

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const breadcrumbs = [
  { label: 'Rishi', href: '/' },
  { label: 'Artifacts', href: '/gallery' },
  { label: collection.display_name }
];

// Generate hex addresses for images - base address is 0x10000000, increment by file size
const BASE_ADDRESS = 0x10000000;
let cumulativeSize = 0;
const imagesWithHex = collection.images.map((img, index) => {
  const hexAddress = `0x${(BASE_ADDRESS + cumulativeSize).toString(16).toUpperCase().padStart(8, '0')}`;
  const currentSize = img.file_size || 1024 * 1024; // Default to 1MB if size not available
  
  const result = {
    ...img,
    hexAddress,
    index,
    offsetBytes: cumulativeSize,
    sizeBytes: currentSize
  };
  
  // Add current image size to cumulative for next iteration
  cumulativeSize += currentSize;
  
  return result;
});

// Helper to format captured date
function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const month = months[date.getMonth()];
  const day = date.getDate().toString().padStart(2, '0');
  const year = date.getFullYear();
  return `${day} ${month} ${year}`;
}
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="canonical" href={canonicalURL} />
    
    <title>{collection.display_name} | Artifacts</title>
    <meta name="description" content={`Memory tape from ${collection.display_name}`} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={`${collection.display_name} | Artifacts`} />
    <meta property="og:description" content={`Memory tape from ${collection.display_name}`} />
    {collection.cover_image_url && <meta property="og:image" content={collection.cover_image_url} />}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${collection.display_name} | Artifacts`} />
    <meta name="twitter:description" content={`Memory tape from ${collection.display_name}`} />
    {collection.cover_image_url && <meta name="twitter:image" content={collection.cover_image_url} />}
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=PT+Mono&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <script is:inline>
      const theme = localStorage.getItem('theme') || 
                    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="bg-codGray text-quillGray">
  <style>
    .breadcrumb-wrapper {
      position: fixed;
      top: 2rem;
      left: 2rem;
      z-index: 104;
      background: rgba(var(--codGray-rgb), 0.95);
      padding: 0.5rem 1rem;
      border: 1px solid var(--gunSmoke);
      backdrop-filter: blur(10px);
    }
    
    @media (max-width: 768px) {
      .breadcrumb-wrapper {
        top: 1rem;
        left: 1rem;
        padding: 0.5rem 0.75rem;
      }
    }
    
    main {
      position: relative;
      height: 100vh;
      overflow: hidden;
      background: var(--codGray);
    }
    
    main::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.05'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }
    
    .tape-container {
      font-family: 'PT Mono', monospace;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      position: relative;
      height: 100vh;
      background: transparent;
      scroll-padding: 0;
    }
    
    .tape-container::-webkit-scrollbar {
      display: none;
    }
    
    .tape-track {
      display: flex;
      height: 100%;
      width: max-content;
      padding: 0 50vw;
      position: relative;
    }
    
    .tape-track::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      width: 100%;
      height: 0;
      border-bottom: 2px dashed #333;
      transform: translateY(-50%);
      z-index: 0;
      pointer-events: none;
    }
    
    .tape-cell {
      flex-shrink: 0;
      width: 60vw;
      max-width: 600px;
      height: 100%;
      scroll-snap-align: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 2rem;
      position: relative;
      transition: opacity 0.3s ease, transform 0.3s ease;
      z-index: 2;
    }
    
    .tape-cell.inactive {
      opacity: 0.5;
      transform: scale(0.92);
    }
    
    .tape-cell.active {
      opacity: 1;
      transform: scale(1);
      z-index: 3;
    }
    
    .read-head {
      position: fixed;
      left: 50%;
      top: 50%;
      width: 50vw;
      max-width: 560px;
      height: 42vh;
      max-height: 480px;
      transform: translate(-50%, -50%);
      z-index: 101;
      pointer-events: none;
    }
    
    .bracket {
      position: absolute;
      width: 60px;
      height: 60px;
      border: 3px solid rgb(var(--accent-light));
      box-shadow: 0 0 20px rgba(var(--accent-light), 0.6);
    }
    
    .bracket-tl {
      top: 0;
      left: 0;
      border-right: none;
      border-bottom: none;
    }
    
    .bracket-tr {
      top: 0;
      right: 0;
      border-left: none;
      border-bottom: none;
    }
    
    .bracket-bl {
      bottom: 0;
      left: 0;
      border-right: none;
      border-top: none;
    }
    
    .bracket-br {
      bottom: 0;
      right: 0;
      border-left: none;
      border-top: none;
    }
    
    @media (max-width: 768px) {
      .read-head {
        width: 85vw;
        max-width: 100%;
        height: 60vh;
      }
      
      .bracket {
        width: 50px;
        height: 50px;
        border-width: 4px;
      }
    }
    
    .metadata-display {
      position: fixed;
      top: 2rem;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(var(--codGray-rgb), 0.95);
      border: 1px solid var(--gunSmoke);
      padding: 0.75rem 1.5rem;
      font-size: 0.85rem;
      color: var(--quillGray);
      z-index: 102;
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      min-width: 300px;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .date-display {
      font-size: 0.9rem;
      color: var(--quillGray);
      font-weight: 500;
    }
    
    .metadata-display:hover .address-tooltip {
      opacity: 1;
      visibility: visible;
    }
    
    .hex-label:hover .address-tooltip {
      opacity: 1;
      visibility: visible;
    }
    
    .hex-label {
      color: rgb(var(--accent-light));
      font-weight: 600;
      letter-spacing: 0.05em;
      position: relative;
      cursor: help;
    }
    
    .address-tooltip {
      position: absolute;
      left: 100%;
      top: 50%;
      transform: translateY(-50%);
      margin-left: 1rem;
      background: #1d1d1d;
      border: 1px solid rgb(var(--accent-light));
      padding: 0.5rem 0.75rem;
      font-size: 0.75rem;
      white-space: nowrap;
      opacity: 0;
      visibility: hidden;
      transition: all 0.2s ease;
      z-index: 1000;
    }
    
    .tooltip-row {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin: 0.25rem 0;
    }
    
    .tooltip-label {
      color: var(--gunSmoke);
    }
    
    .tooltip-value {
      color: rgb(var(--accent-light));
      font-weight: 600;
    }
    
    @media (max-width: 768px) {
      .address-tooltip {
        left: 50%;
        top: 100%;
        transform: translateX(-50%);
        margin-left: 0;
        margin-top: 0.5rem;
      }
      
      .metadata-display {
        top: 4.5rem;
        padding: 0.5rem 1rem;
        min-width: auto;
        font-size: 0.75rem;
        gap: 0.25rem;
      }
    }
    
    .image-frame {
      width: min(100%, calc(42vh * var(--media-ratio, 1.333333)));
      max-width: 500px;
      aspect-ratio: var(--media-aspect-ratio, 4 / 3);
      background: rgba(var(--darkGrey-rgb), 0.3);
      border: 1px solid var(--gunSmoke);
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .image-frame img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }
    
    .image-frame video {
      width: 100%;
      height: auto;
      max-height: 42vh;
      object-fit: contain;
      display: block;
    }
    
    .image-frame.video-frame {
      aspect-ratio: unset;
      height: auto;
      max-width: 50vw;
      max-height: 42vh;
      background: #000;
    }
    
    @media (max-width: 768px) {
      .image-frame:not(.video-frame) {
        width: min(100%, calc(60vh * var(--media-ratio, 1.333333)));
        max-width: 85vw;
      }

      .image-frame.video-frame {
        max-width: 85vw;
        max-height: 60vh;
      }
      
      .image-frame video {
        max-height: 60vh;
      }
    }
    
    .image-caption {
      position: fixed;
      bottom: 5.5rem;
      left: 50%;
      transform: translateX(-50%);
      color: var(--quillGray);
      font-size: 0.875rem;
      text-align: center;
      max-width: 500px;
      padding: 0.5rem 1rem;
      background: rgba(var(--codGray-rgb), 0.9);
      border: 1px solid var(--gunSmoke);
      backdrop-filter: blur(10px);
      z-index: 100;
      opacity: 0;
      transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                  transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
      will-change: opacity, transform;
    }
    
    .image-caption.visible {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    
    .image-caption.hidden {
      opacity: 0;
      transform: translateX(-50%) translateY(-15px);
    }
    
    .image-caption.exit {
      opacity: 0;
      transform: translateX(-50%) translateY(15px);
    }
    
    .tape-controls {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 1rem;
      z-index: 99;
      background: rgba(var(--codGray-rgb), 0.95);
      padding: 0.75rem 1.5rem;
      border: 1px solid var(--gunSmoke);
      backdrop-filter: blur(10px);
    }
    
    .tape-controls button {
      background: transparent;
      border: 1px solid var(--gunSmoke);
      color: var(--quillGray);
      padding: 0.5rem 1rem;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: 'PT Mono', monospace;
      font-size: 0.875rem;
    }
    
    .tape-controls button:hover {
      border-color: var(--accent-light);
      color: var(--accent-light);
    }
    
    /* Removed back-link - using breadcrumb for navigation */
    
    .position-indicator {
      font-size: 0.75rem;
      color: var(--gunSmoke);
    }
    
    .event-title-display {
      font-size: 0.9rem;
      color: var(--quillGray);
    }
    
    .memory-bar {
      position: fixed;
      bottom: 6rem;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      max-width: 600px;
      height: 8px;
      background: rgba(var(--darkGrey-rgb), 0.5);
      border: 1px solid var(--gunSmoke);
      z-index: 99;
      display: flex;
      overflow: hidden;
    }
    
    .memory-segment {
      height: 100%;
      background: rgba(var(--gunSmoke-rgb), 0.3);
      border-right: 1px solid var(--codGray);
      transition: all 0.3s ease;
    }
    
    .memory-segment.active {
      background: rgb(var(--accent-light));
      box-shadow: 0 0 8px rgba(var(--accent-light), 0.6);
    }
    
    .memory-segment.active {
      background: var(--accent-light);
      box-shadow: 0 0 10px rgba(var(--accent-light-rgb), 0.5);
    }
    
    @media (max-width: 768px) {
      .tape-cell {
        width: 90vw;
        padding: 1rem;
      }
      
      .metadata-display {
        min-width: auto;
        width: calc(100vw - 4rem);
      }
      
      .tape-controls {
        width: calc(100vw - 4rem);
        justify-content: space-between;
      }
      
      .image-caption {
        max-width: calc(100vw - 4rem);
        font-size: 0.8rem;
        bottom: 5rem;
      }
    }
    
    /* Pull-to-navigate indicators */
    .pull-indicator {
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(var(--codGray-rgb), 0.9);
      border: 1px solid rgba(var(--accent-light-rgb), 0.5);
      padding: 0.5rem 0.75rem;
      font-size: 0.85rem;
      color: rgba(var(--accent-light-rgb), 0.8);
      font-weight: 500;
      z-index: 105;
      backdrop-filter: blur(8px);
      opacity: 0;
      transition: all 0.3s ease;
      cursor: pointer;
      pointer-events: auto;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      border-radius: 4px;
    }
    
    .pull-indicator:hover {
      background: rgba(var(--codGray-rgb), 0.95);
      border-color: rgb(var(--accent-light));
      color: rgb(var(--accent-light));
    }
    
    .pull-indicator-left {
      left: 1.5rem;
    }
    
    .pull-indicator-right {
      right: 1.5rem;
    }
    
    .pull-indicator.at-boundary {
      opacity: 0.6;
    }
    
    .pull-indicator.visible {
      opacity: 1;
    }
    
    .pull-indicator.active {
      border-color: #4ade80;
      color: #4ade80;
      background: rgba(74, 222, 128, 0.1);
      transform: translateY(-50%) scale(1.02);
    }
    
    @media (max-width: 768px) {
      .pull-indicator {
        left: 50% !important;
        right: auto !important;
        transform: translate(-50%, -50%);
        font-size: 0.875rem;
        padding: 0.75rem 1rem;
      }
      
      .pull-indicator-left {
        top: 20%;
      }
      
      .pull-indicator-right {
        top: 80%;
      }
    }
  </style>

  <div class="breadcrumb-wrapper">
    <Breadcrumbs client:load items={breadcrumbs} />
  </div>
  
  {prevCollection && (
    <a href={`/gallery/${prevCollection.slug}`} class="pull-indicator pull-indicator-left" id="pullIndicatorLeft">
      <span>←</span>
      <span>{prevCollection.display_name}</span>
    </a>
  )}
  
  {nextCollection && (
    <a href={`/gallery/${nextCollection.slug}`} class="pull-indicator pull-indicator-right" id="pullIndicatorRight">
      <span>{nextCollection.display_name}</span>
      <span>→</span>
    </a>
  )}
  
  <main class="relative">    
    <div class="read-head">
      <div class="bracket bracket-tl"></div>
      <div class="bracket bracket-tr"></div>
      <div class="bracket bracket-bl"></div>
      <div class="bracket bracket-br"></div>
    </div>
    
    <div id="metadataDisplay" class="metadata-display">
      <div class="hex-label">
        <span id="hexLabel">0x00000000</span>
        <div class="address-tooltip" id="addressTooltip">
          <div class="tooltip-row">
            <span class="tooltip-label">Base:</span>
            <span class="tooltip-value">0x10000000</span>
          </div>
          <div class="tooltip-row">
            <span class="tooltip-label">Offset:</span>
            <span class="tooltip-value" id="tooltipOffset">+0 bytes</span>
          </div>
          <div class="tooltip-row">
            <span class="tooltip-label">Size:</span>
            <span class="tooltip-value" id="tooltipSize">0 KB</span>
          </div>
        </div>
      </div>
      <div class="date-display" id="dateDisplay">Loading...</div>
      <div class="position-indicator" id="positionIndicator">0 / {imagesWithHex.length}</div>
    </div>
    
    <div class="tape-container" id="tapeContainer">
      <div class="tape-track">
        {imagesWithHex.map((image) => {
          const isVideo = image.mime_type?.startsWith('video/');
          const mediaWidth = image.width && image.width > 0 ? image.width : 4;
          const mediaHeight = image.height && image.height > 0 ? image.height : 3;
          const imageFrameStyle = isVideo
            ? undefined
            : `--media-ratio: ${mediaWidth / mediaHeight}; --media-aspect-ratio: ${mediaWidth} / ${mediaHeight};`;

          return (
          <div class="tape-cell" class:list={[{ active: image.index === 0, inactive: image.index !== 0 }]} data-hex={image.hexAddress} data-index={image.index} data-caption={image.description || ''} data-date={image.captured_date} data-is-video={isVideo}>
            <div class:list={['image-frame', { 'video-frame': isVideo }]} style={imageFrameStyle}>
              {isVideo ? (
                <video
                  src={image.r2_url}
                  title={`${formatDate(image.captured_date)}`}
                  controls
                  muted
                  loop
                  playsinline
                />
              ) : (
                <img
                  src={image.r2_url}
                  alt={`${formatDate(image.captured_date)}`}
                  loading="lazy"
                />
              )}
            </div>
          </div>
        )})}
      </div>
    </div>
    
    {/* Fixed caption element */}
    <div id="imageCaption" class="image-caption hidden"></div>
    
    <div class="tape-controls">
      <button id="prevBtn">← Prev</button>
      <button id="nextBtn">Next →</button>
    </div>
    
    <div class="memory-bar" id="memoryBar">
      {imagesWithHex.map((image, idx) => {
        const totalSize = imagesWithHex.reduce((sum, img) => sum + (img.sizeBytes || 0), 0);
        const widthPercent = ((image.sizeBytes || 0) / totalSize) * 100;
        return (
          <div 
            class="memory-segment" 
            data-index={idx}
            style={`width: ${widthPercent}%`}
          />
        );
      })}
    </div>
  </main>

  <script define:vars={{ 
    images: imagesWithHex,
    prevCollectionSlug: prevCollection?.slug,
    nextCollectionSlug: nextCollection?.slug
  }}>
    const container = document.getElementById('tapeContainer');
    const cells = document.querySelectorAll('.tape-cell');
    const hexLabel = document.getElementById('hexLabel');
    const addressTooltip = document.getElementById('addressTooltip');
    const tooltipOffset = document.getElementById('tooltipOffset');
    const tooltipSize = document.getElementById('tooltipSize');
    const positionIndicator = document.getElementById('positionIndicator');
    const dateDisplay = document.getElementById('dateDisplay');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const memorySegments = document.querySelectorAll('.memory-segment');
    const imageCaption = document.getElementById('imageCaption');
    const pullIndicatorLeft = document.getElementById('pullIndicatorLeft');
    const pullIndicatorRight = document.getElementById('pullIndicatorRight');
    
    let currentIndex = 0;
    
    // Pull-to-navigate state
    const PULL_THRESHOLD = 120; // pixels
    let isPulling = false;
    let pullStartX = 0;
    let pullDistance = 0;
    let isAtStart = false;
    let isAtEnd = false;
    
    // Calculate total size
    const totalSize = images.reduce((sum, img) => sum + (img.file_size || 1024 * 1024), 0);
    
    function formatBytes(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }
    
    function updateActiveCell() {
      const containerRect = container.getBoundingClientRect();
      const centerX = containerRect.left + containerRect.width / 2;
      
      let closestCell = null;
      let closestDistance = Infinity;
      let closestIndex = 0;
      
      cells.forEach((cell, index) => {
        const rect = cell.getBoundingClientRect();
        const cellCenterX = rect.left + rect.width / 2;
        const distance = Math.abs(cellCenterX - centerX);
        
        if (distance < closestDistance) {
          closestDistance = distance;
          closestCell = cell;
          closestIndex = index;
        }
      });
      
      // Update active/inactive classes
      cells.forEach((cell, index) => {
        if (index === closestIndex) {
          cell.classList.remove('inactive');
          cell.classList.add('active');
        } else {
          cell.classList.remove('active');
          cell.classList.add('inactive');
        }
      });
      
      if (closestCell && closestIndex !== currentIndex) {
        currentIndex = closestIndex;
        const hexAddress = closestCell.getAttribute('data-hex');
        const currentImage = images[closestIndex];
        const imageSize = currentImage.sizeBytes || 1024 * 1024;
        const offsetSize = currentImage.offsetBytes || 0;
        
        // Update hex address
        hexLabel.textContent = hexAddress;
        
        // Update tooltip content
        if (tooltipOffset && tooltipSize) {
          tooltipOffset.textContent = `+${formatBytes(offsetSize)}`;
          tooltipSize.textContent = formatBytes(imageSize);
        }
        
        positionIndicator.textContent = `${currentIndex + 1} / ${images.length}`;
        
        // Update date display
        const imageDate = closestCell.getAttribute('data-date');
        if (imageDate) {
          const date = new Date(imageDate);
          const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
          const formattedDate = `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
          dateDisplay.textContent = formattedDate;
        }
        
        // Check boundaries and update indicators
        checkBoundaries();
        updatePullIndicators();
        
        // Update memory bar highlighting
        memorySegments.forEach((seg, idx) => {
          if (idx === currentIndex) {
            seg.classList.add('active');
          } else {
            seg.classList.remove('active');
          }
        });
        
        // Update caption with animation
        const caption = closestCell.getAttribute('data-caption');
        const currentCaption = imageCaption.textContent;
        
        if (caption && caption.trim()) {
          // Only animate if caption is different
          if (currentCaption !== caption) {
            // Slide up and fade out (exit animation)
            imageCaption.classList.remove('visible', 'hidden');
            imageCaption.classList.add('exit');
            
            // Update text and slide down with fade in after exit animation
            setTimeout(() => {
              imageCaption.textContent = caption;
              imageCaption.classList.remove('exit');
              imageCaption.classList.add('hidden');
              
              // Trigger entry animation
              requestAnimationFrame(() => {
                imageCaption.classList.remove('hidden');
                imageCaption.classList.add('visible');
              });
            }, 150);
          } else if (!imageCaption.classList.contains('visible')) {
            // Same caption but was hidden, just show it
            imageCaption.classList.remove('hidden', 'exit');
            imageCaption.classList.add('visible');
          }
        } else {
          // Hide caption if no description
          imageCaption.classList.remove('visible');
          imageCaption.classList.add('exit');
        }
        
        // Haptic feedback (if supported)
        if ('vibrate' in navigator) {
          navigator.vibrate(10);
        }
      }
    }
    
    function scrollToIndex(index) {
      if (index < 0 || index >= cells.length) return;
      
      const cell = cells[index];
      const containerRect = container.getBoundingClientRect();
      const cellRect = cell.getBoundingClientRect();
      const scrollAmount = cellRect.left - containerRect.left - containerRect.width / 2 + cellRect.width / 2;
      
      container.scrollBy({
        left: scrollAmount,
        behavior: 'smooth'
      });
    }
    
    // Event listeners
    let isScrolling;
    container.addEventListener('scroll', () => {
      clearTimeout(isScrolling);
      isScrolling = setTimeout(() => {
        updateActiveCell();
        checkBoundaries();
      }, 50);
    });
    
    // Check if at start or end of tape
    function checkBoundaries() {
      // Check based on which cell is active, not scroll position
      isAtStart = currentIndex === 0;
      isAtEnd = currentIndex === cells.length - 1;
      
      return { isAtStart, isAtEnd };
    }
    
    // Update pull indicators
    function updatePullIndicators() {
      // Left indicator (previous collection)
      if (pullIndicatorLeft) {
        if (isAtStart) {
          pullIndicatorLeft.classList.add('at-boundary');
          
          if (pullDistance > 20) {
            pullIndicatorLeft.classList.add('visible');
            pullIndicatorLeft.classList.remove('at-boundary');
            
            if (pullDistance > PULL_THRESHOLD) {
              pullIndicatorLeft.classList.add('active');
            } else {
              pullIndicatorLeft.classList.remove('active');
            }
          } else {
            pullIndicatorLeft.classList.remove('visible', 'active');
            pullIndicatorLeft.classList.add('at-boundary');
          }
        } else {
          pullIndicatorLeft.classList.remove('visible', 'active', 'at-boundary');
        }
      }
      
      // Right indicator (next collection)
      if (pullIndicatorRight) {
        if (isAtEnd) {
          pullIndicatorRight.classList.add('at-boundary');
          
          if (pullDistance < -20) {
            pullIndicatorRight.classList.add('visible');
            pullIndicatorRight.classList.remove('at-boundary');
            
            if (Math.abs(pullDistance) > PULL_THRESHOLD) {
              pullIndicatorRight.classList.add('active');
            } else {
              pullIndicatorRight.classList.remove('active');
            }
          } else {
            pullIndicatorRight.classList.remove('visible', 'active');
            pullIndicatorRight.classList.add('at-boundary');
          }
        } else {
          pullIndicatorRight.classList.remove('visible', 'active', 'at-boundary');
        }
      }
    }
    
    // Touch and mouse events for pull-to-navigate
    let startX = 0;
    let scrollStarted = false;
    let initialScrollLeft = 0;
    
    container.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      initialScrollLeft = container.scrollLeft;
      scrollStarted = true;
      isPulling = false;
      pullDistance = 0;
      checkBoundaries();
      
      console.log('Touch start - isAtStart:', isAtStart, 'isAtEnd:', isAtEnd, 'currentIndex:', currentIndex);
    });
    
    container.addEventListener('mousedown', (e) => {
      startX = e.clientX;
      initialScrollLeft = container.scrollLeft;
      scrollStarted = true;
      isPulling = false;
      pullDistance = 0;
      checkBoundaries();
    });
    
    container.addEventListener('touchmove', (e) => {
      if (!scrollStarted) return;
      
      const currentX = e.touches[0].clientX;
      const deltaX = currentX - startX;
      
      // Re-check boundaries based on current active cell
      checkBoundaries();
      
      // At first image and swiping right (pulling to go to previous collection)
      if (isAtStart && deltaX > 20) {
        isPulling = true;
        pullDistance = deltaX;
        updatePullIndicators();
        
        console.log('Pulling LEFT indicator - distance:', pullDistance);
        
        // Only prevent default when actually pulling past boundary
        if (deltaX > 40) {
          e.preventDefault();
        }
      } 
      // At last image and swiping left (pulling to go to next collection)
      else if (isAtEnd && deltaX < -20) {
        isPulling = true;
        pullDistance = deltaX;
        updatePullIndicators();
        
        console.log('Pulling RIGHT indicator - distance:', pullDistance);
        
        // Only prevent default when actually pulling past boundary
        if (deltaX < -40) {
          e.preventDefault();
        }
      } else {
        // Reset pulling if we're back in normal range
        if (isPulling && Math.abs(deltaX) < 15) {
          isPulling = false;
          pullDistance = 0;
          updatePullIndicators();
        }
      }
    });
    
    container.addEventListener('mousemove', (e) => {
      if (!scrollStarted) return;
      
      const currentX = e.clientX;
      const deltaX = currentX - startX;
      
      // Check boundaries in real-time
      const bounds = checkBoundaries();
      
      // Mouse drag: at start pull right, at end pull left
      if (bounds.isAtStart && deltaX > 30) {
        isPulling = true;
        pullDistance = deltaX;
        updatePullIndicators();
      } else if (bounds.isAtEnd && deltaX < -30) {
        isPulling = true;
        pullDistance = deltaX;
        updatePullIndicators();
      } else {
        if (isPulling && Math.abs(deltaX) < 20) {
          isPulling = false;
          pullDistance = 0;
          updatePullIndicators();
        }
      }
    });
    
    container.addEventListener('touchend', (e) => {
      if (scrollStarted) {
        console.log('Touch end - isPulling:', isPulling, 'pullDistance:', pullDistance, 'isAtStart:', isAtStart, 'isAtEnd:', isAtEnd);
        
        // Check if we should navigate
        if (isPulling) {
          if (isAtStart && pullDistance > PULL_THRESHOLD && prevCollectionSlug) {
            // Navigate to previous collection
            console.log('Navigating to previous:', prevCollectionSlug);
            if ('vibrate' in navigator) navigator.vibrate(20);
            window.location.href = `/gallery/${prevCollectionSlug}`;
            return;
          } else if (isAtEnd && pullDistance < -PULL_THRESHOLD && nextCollectionSlug) {
            // Navigate to next collection
            console.log('Navigating to next:', nextCollectionSlug);
            if ('vibrate' in navigator) navigator.vibrate(20);
            window.location.href = `/gallery/${nextCollectionSlug}`;
            return;
          }
        }
        
        // Reset
        isPulling = false;
        pullDistance = 0;
        updatePullIndicators();
        scrollStarted = false;
        
        // Normal haptic feedback for swipe
        const endX = e.changedTouches[0].clientX;
        const diff = startX - endX;
        if (Math.abs(diff) > 50 && 'vibrate' in navigator) {
          navigator.vibrate(15);
        }
      }
    });
    
    container.addEventListener('mouseup', (e) => {
      if (scrollStarted) {
        // Check if we should navigate
        if (isPulling) {
          if (isAtStart && pullDistance > PULL_THRESHOLD && prevCollectionSlug) {
            window.location.href = `/gallery/${prevCollectionSlug}`;
            return;
          } else if (isAtEnd && pullDistance < -PULL_THRESHOLD && nextCollectionSlug) {
            window.location.href = `/gallery/${nextCollectionSlug}`;
            return;
          }
        }
        
        // Reset
        isPulling = false;
        pullDistance = 0;
        updatePullIndicators();
        scrollStarted = false;
      }
    });
    
    prevBtn.addEventListener('click', () => {
      scrollToIndex(currentIndex - 1);
    });
    
    nextBtn.addEventListener('click', () => {
      scrollToIndex(currentIndex + 1);
    });
    
    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        scrollToIndex(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        scrollToIndex(currentIndex + 1);
      }
    });
    
    // Initial update - make sure first cell is active
    if (cells.length > 0) {
      cells[0].classList.add('active');
      cells[0].classList.remove('inactive');
      currentIndex = 0;
      
      const firstImage = images[0];
      hexLabel.textContent = firstImage.hexAddress;
      if (tooltipOffset && tooltipSize) {
        tooltipOffset.textContent = `+${formatBytes(firstImage.offsetBytes || 0)}`;
        tooltipSize.textContent = formatBytes(firstImage.sizeBytes || 1024 * 1024);
      }
      positionIndicator.textContent = `1 / ${images.length}`;
      if (memorySegments.length > 0) {
        memorySegments[0].classList.add('active');
      }
      
      // Set initial date
      const firstImageDate = cells[0].getAttribute('data-date');
      if (firstImageDate) {
        const date = new Date(firstImageDate);
        const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        const formattedDate = `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
        dateDisplay.textContent = formattedDate;
      }
      
      // Show initial caption
      const firstCaption = cells[0].getAttribute('data-caption');
      if (firstCaption && firstCaption.trim()) {
        setTimeout(() => {
          imageCaption.textContent = firstCaption;
          imageCaption.classList.remove('hidden', 'exit');
          imageCaption.classList.add('visible');
        }, 300);
      }
      
      // Scroll first image to center
      const firstCell = cells[0];
      const containerRect = container.getBoundingClientRect();
      const cellRect = firstCell.getBoundingClientRect();
      const scrollAmount = cellRect.left - containerRect.left - containerRect.width / 2 + cellRect.width / 2;
      container.scrollBy({
        left: scrollAmount,
        behavior: 'auto'
      });
    }
    
    // Run update after a brief delay for scroll position
    setTimeout(updateActiveCell, 100);
  </script>
  </body>
</html>
