---
import GalleryLayout from '../../layouts/GalleryLayout.astro';
import { getAllGalleryCollections, getGalleryCollectionBySlug } from '../../lib/gallery';
import GalleryFrame from '../../components/gallery/GalleryFrame.astro';
import {
  THUMB_WIDTH, dateRange, frameAnchor, frameCount, isVideo, resized, shareImage, sortRolls,
} from '../../lib/galleryFrames';

export async function getStaticPaths() {
  const collections = await getAllGalleryCollections();
  return collections.map((collection) => ({ params: { slug: collection.slug } }));
}

const { slug } = Astro.params;
const roll = await getGalleryCollectionBySlug(slug!);
if (!roll) return Astro.redirect('/gallery');

const rolls = sortRolls(await getAllGalleryCollections());
const position = rolls.findIndex((entry) => entry.slug === slug);
const newer = position > 0 ? rolls[position - 1] : undefined;
const older = position >= 0 && position < rolls.length - 1 ? rolls[position + 1] : undefined;

const frames = roll.images;
const total = frames.length;
const range = dateRange(frames);
---

<GalleryLayout
  title={`${roll.display_name} · Gallery · Rishi Ahuja`}
  description={`${frameCount(total)} from ${roll.display_name}${range ? `, ${range}` : ''}.`}
  image={shareImage([roll.cover_image_url, ...roll.images.filter((frame) => !isVideo(frame)).map((frame) => frame.r2_url)])}
>
  <section class="gallery-intro wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/gallery">Gallery</a><span aria-hidden="true">›</span></nav>
    <h1>{roll.display_name}</h1>
    <p class="gallery-lede">{frameCount(total)}{range && <> · {range}</>}</p>
  </section>

  <div class="wrap">
    {total === 0 ? (
      <p class="empty-state">This roll is empty for now.</p>
    ) : (
      <>
        <ol class="contact-strip" aria-label="Contact sheet" data-contact-strip>
          {frames.map((frame, index) => (
            <li>
              <a href={`#${frameAnchor(frame)}`} aria-label={`Frame ${index + 1}${frame.description ? `: ${frame.description}` : ''}`} data-strip-frame={index + 1}>
                {isVideo(frame)
                  ? <span class="strip-video" aria-hidden="true">▶</span>
                  : <img src={resized(frame.r2_url, THUMB_WIDTH, 60)} alt="" width="64" height="64" loading="lazy" decoding="async" />}
              </a>
            </li>
          ))}
        </ol>
        <p class="keys-hint">Use J and K, or the left and right arrow keys, to move between frames.</p>

        <ol class="frames">
          {frames.map((frame, index) => (
            <li><GalleryFrame frame={frame} index={index} total={total} slug={roll.slug} rollTitle={roll.display_name} eager={index < 2} /></li>
          ))}
        </ol>
      </>
    )}

    <nav class="roll-nav" aria-label="Other rolls">
      {older && <a class="older" href={`/gallery/${older.slug}`}><small>← Earlier roll</small>{older.display_name}</a>}
      {newer && <a class="newer" href={`/gallery/${newer.slug}`}><small>Later roll →</small>{newer.display_name}</a>}
    </nav>
  </div>
</GalleryLayout>

<script>
  import '../../scripts/galleryShare';

  // Highlights the frame in view on the contact strip and lets J/K or the
  // arrow keys step through frames.
  const frames = [...document.querySelectorAll<HTMLElement>('[data-frame]')];
  const strip = document.querySelector<HTMLElement>('[data-contact-strip]');
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-strip-frame]')].map((link) => [link.dataset.stripFrame, link]));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let current = 0;

  const mark = (index: number) => {
    current = index;
    links.forEach((link) => link.removeAttribute('aria-current'));
    const link = links.get(String(index + 1));
    if (!link || !strip) return;
    link.setAttribute('aria-current', 'true');
    // Scroll the strip sideways only, never the page.
    const left = link.offsetLeft - strip.clientWidth / 2 + link.clientWidth / 2;
    strip.scrollTo({ left, behavior: reduceMotion ? 'auto' : 'smooth' });
  };

  if (frames.length) {
    const visible = new Map<number, number>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) visible.set(frames.indexOf(entry.target as HTMLElement), entry.intersectionRatio);
      const [best] = [...visible.entries()].sort((a, b) => b[1] - a[1]);
      if (best && best[1] > 0) mark(best[0]);
    }, { threshold: [0, 0.25, 0.5, 0.75, 1] });
    frames.forEach((frame) => observer.observe(frame));
    mark(0);

    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      if (event.metaKey || event.ctrlKey || event.altKey || target.closest('input, textarea, video, [contenteditable]')) return;
      const step = event.key === 'j' || event.key === 'ArrowRight' ? 1 : event.key === 'k' || event.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = Math.min(frames.length - 1, Math.max(0, current + step));
      event.preventDefault();
      frames[next].scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      mark(next);
    });
  }
</script>
