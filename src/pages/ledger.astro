---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs';
import TimelineView from '../components/TimelineView.tsx';
import { timelineData, type TimelineEvent } from '../data/timeline';

const breadcrumbs = [
  { label: 'Rishi', href: '/' },
  { label: 'Life Ledger' }
];

const ledgerTimelineData = Object.fromEntries(
  Object.entries(timelineData).map(([year, items]) => [
    year,
    items.map((item): TimelineEvent => (
      item.hiddenInLedger
        ? {
            ...item,
            date: '',
            title: '',
            description: '',
            link: undefined,
            blurbSlug: undefined,
            gallerySlug: undefined,
            buttons: [],
          }
        : item
    )),
  ]),
) as Record<string, TimelineEvent[]>;
---

<BaseLayout 
  title="Life Ledger | Rishi Ahuja"
  description="A running log of my life events"
  image="/og?title=Life%20Ledger&description=A%20running%20log%20of%20my%20life%20events&type=default"
>
  <div class="px-4 md:px-8 pt-12">
    <div class="max-w-6xl mx-auto">
      <Breadcrumbs client:load items={breadcrumbs} />
    </div>
  </div>
  <TimelineView client:load timelineData={ledgerTimelineData} />
</BaseLayout>
