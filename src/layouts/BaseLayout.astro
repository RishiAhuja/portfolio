---
import '../styles/globals.css';
import Header from '../components/Header';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
}

const {
  title = 'Rishi Ahuja | Full Stack Developer & Designer',
  description = 'Portfolio of Rishi Ahuja, a full stack developer and designer specializing in web and mobile app development.',
  image = '/og-image.png',
  imageWidth = 1200,
  imageHeight = 630,
  imageType = 'image/png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const imageURL = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Rishi Ahuja, developer portfolio, full stack developer, web development, mobile development, Flutter, React, Astro, TypeScript, C++, FernKit, OpenLearn, software engineer, NITJ, technical blogs, WebSockets, text rendering, system programming" />
    <meta name="author" content="Rishi Ahuja" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#191919" />
    
    <!-- Verification Tags (add your verification codes when available) -->
    <!-- <meta name="google-site-verification" content="YOUR_GOOGLE_CODE" /> -->
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Rishi Ahuja",
      "url": Astro.site,
      "image": imageURL,
      "sameAs": [
        "https://github.com/RishiAhuja",
        "https://www.linkedin.com/in/rishi-ahuja-b1a224310",
        "https://twitter.com/Rishi2220",
        "https://rishi2220.hashnode.dev"
      ],
      "jobTitle": "Full Stack Developer",
      "worksFor": {
        "@type": "Organization",
        "name": "OpenLearn"
      },
      "alumniOf": {
        "@type": "Organization",
        "name": "Dr. B.R. Ambedkar National Institute of Technology Jalandhar"
      },
      "knowsAbout": ["Web Development", "Mobile Development", "System Programming", "UI/UX Design", "Flutter", "React", "TypeScript", "C++", "Python"],
    })} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:site_name" content="Rishi Ahuja - Developer Portfolio" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rishi2220" />
    <meta name="twitter:creator" content="@rishi2220" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=PT+Mono&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Twitter Widget Script -->
    <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>

    <!-- Additional head elements from pages -->
    <slot name="head" />

    <!-- Theme Script (runs before page load to prevent flash) -->
    <script is:inline>
      // Prevent FOUC (Flash of Unstyled Content)
      const theme = localStorage.getItem('theme') || 
                    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>

    <style is:global>
      :root {
        --font-pt-mono: 'PT Mono', monospace;
        --font-inter: 'Inter', sans-serif;
        --font-playfair: 'Playfair Display', serif;
      }
    </style>
  </head>
  <body class="bg-codGray text-quillGray dark:bg-bgShades-dark dark:text-quillGray transition-colors duration-300">
    <Header client:load currentPath={currentPath} />
    <slot />

    <!-- Lamatic portfolio assistant -->
    <script is:inline async>
      (function () {
        const PROJECT_ID = '6de4aaa5-374f-465b-8a85-3fca80443fe5';
        const FLOW_ID = 'c61a4fd4-432e-4ef3-9682-2b1a0016484f';
        const API_URL = 'https://rishisorganization322-rishisproject461.lamatic.dev';

        function loadLamaticChat() {
          if (document.getElementById('lamatic-chat-root')) return;

          const root = document.createElement('div');
          root.id = 'lamatic-chat-root';
          root.dataset.apiUrl = API_URL;
          root.dataset.flowId = FLOW_ID;
          root.dataset.projectId = PROJECT_ID;
          document.body.appendChild(root);

          const script = document.createElement('script');
          script.type = 'module';
          script.src = 'https://widget.lamatic.ai/chat-v2?projectId=' + PROJECT_ID;
          document.body.appendChild(script);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', loadLamaticChat, { once: true });
        } else {
          loadLamaticChat();
        }
      })();
    </script>
  </body>
</html>
