---
import '../styles/globals.css';
import Header from '../components/Header';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
}

const {
  title = 'Rishi Ahuja | AI Researcher & Engineer',
  description = 'Rishi Ahuja is a student researcher working on trustworthy AI, retrieval, time-series models, and conversational fraud detection.',
  image = '/og?title=Rishi%20Ahuja&description=AI%20researcher%20%26%20engineer%20%C2%B7%20trustworthy%20systems&type=default',
  imageWidth = 1200,
  imageHeight = 630,
  imageType = 'image/png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const imageURL = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Rishi Ahuja, AI researcher, trustworthy AI, LLM evaluation, time series forecasting, retrieval augmented systems, fraud detection, NIT Jalandhar, machine learning research" />
    <meta name="author" content="Rishi Ahuja" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#191919" />
    
    <!-- Verification Tags (add your verification codes when available) -->
    <!-- <meta name="google-site-verification" content="YOUR_GOOGLE_CODE" /> -->
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Rishi Ahuja",
      "url": Astro.site,
      "image": imageURL,
      "sameAs": [
        "https://github.com/RishiAhuja",
        "https://www.linkedin.com/in/rishi-ahuja-b1a224310",
        "https://twitter.com/Rishi2220",
        "https://rishi2220.hashnode.dev"
      ],
      "jobTitle": "Student Researcher",
      "affiliation": {
        "@type": "CollegeOrUniversity",
        "name": "Dr. B.R. Ambedkar National Institute of Technology Jalandhar"
      },
      "knowsAbout": ["Trustworthy AI", "LLM Evaluation", "Time Series Forecasting", "Retrieval-Augmented Systems", "Conversational Fraud Detection"],
    })} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:site_name" content="Rishi Ahuja - AI Researcher" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rishi2220" />
    <meta name="twitter:creator" content="@rishi2220" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=PT+Mono&family=Inter:wght@300;400;500;600;700&family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500;6..72,600&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Twitter Widget Script -->
    <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>

    <!-- Additional head elements from pages -->
    <slot name="head" />

    <!-- Theme Script (runs before page load to prevent flash) -->
    <script is:inline>
      // Prevent FOUC (Flash of Unstyled Content)
      const theme = localStorage.getItem('theme') || 
                    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>

    <style is:global>
      :root {
        --font-pt-mono: 'PT Mono', monospace;
        --font-inter: 'Inter', sans-serif;
        --font-playfair: 'Playfair Display', serif;
        --font-newsreader: 'Newsreader', serif;
        --font-manrope: 'Manrope', sans-serif;
      }
    </style>
  </head>
  <body class="bg-codGray text-quillGray dark:bg-bgShades-dark dark:text-quillGray transition-colors duration-300">
    <Header client:load currentPath={currentPath} />
    <slot />
  </body>
</html>
