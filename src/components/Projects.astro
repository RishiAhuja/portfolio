---
import { getCollection } from 'astro:content';
import ExpandedContainer from './ui/ExpandedContainer.astro';
import ProjectCardCompact from './ui/ProjectCardCompact';

// Get all projects from content collection
const allProjects = await getCollection('projects');

// Sort by date (newest first) and transform to match component expectations
const projects = allProjects
  .sort((a: any, b: any) => b.data.created_at.getTime() - a.data.created_at.getTime())
  .map((project: any) => ({
    id: project.slug,
    slug: project.slug,
    title: project.data.title,
    description: project.data.description,
    tech_stack: project.data.tech_stack,
    features: project.data.features,
    github_url: project.data.github_url,
    live_url: project.data.live_url,
    image_url: project.data.image_url,
    category: project.data.category,
    is_featured: project.data.is_featured,
    created_at: project.data.created_at.toISOString(),
  }));
---

<div class="flex flex-col" id="projects-section">
  <ExpandedContainer text="Things I've Built" />
  <div class="h-4"></div>
  
  {projects.length === 0 ? (
    <div class="py-8 text-center">
      <p class="text-lg font-ptMono text-gray-400">
        No projects found. Check back soon!
      </p>
    </div>
  ) : (
    <>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 group/grid">
        {projects.map((project: any, index: number) => (
          <div class={`project-card h-full transition-all duration-500 hover:!opacity-100 group-hover/grid:opacity-50 ${index >= 4 ? 'hidden' : ''}`}>
            <ProjectCardCompact
              project={project}
              client:load
            />
          </div>
        ))}
      </div>
      
      {projects.length > 4 && (
        <button
          id="show-more-projects"
          class="mt-6 font-ptMono text-sm text-accent-light hover:text-accent transition-colors duration-200 mx-auto block"
        >
          Show {Math.min(projects.length - 4, 4)} more →
        </button>
      )}
    </>
  )}
</div>

<script>
  const showMoreBtn = document.getElementById('show-more-projects');
  
  if (showMoreBtn) {
    let visibleCount = 4;
    const allProjects = Array.from(document.querySelectorAll('.project-card'));
    const totalProjects = allProjects.length;
    
    showMoreBtn.addEventListener('click', () => {
      const remaining = totalProjects - visibleCount;
      const toShow = Math.min(remaining, 4);
      
      // Show next batch
      for (let i = visibleCount; i < visibleCount + toShow; i++) {
        if (allProjects[i]) {
          allProjects[i].classList.remove('hidden');
        }
      }
      
      visibleCount += toShow;
      
      // Update button text or hide it
      if (visibleCount >= totalProjects) {
        showMoreBtn.style.display = 'none';
      } else {
        const newRemaining = totalProjects - visibleCount;
        showMoreBtn.textContent = `Show ${Math.min(newRemaining, 4)} more →`;
      }
    });
  }
</script>
