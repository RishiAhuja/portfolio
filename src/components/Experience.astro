---
import ExpandedContainer from './ui/ExpandedContainer.astro';
import ExperienceCard from './ui/ExperienceCard';
---

<div class="flex flex-col">
  <ExpandedContainer text="Chapters" />
  <div class="h-4"></div>
  <div class="relative border-l border-darkGrey/30 ml-3 md:ml-4 space-y-8 pl-6 md:pl-8 py-2">
    <div class="relative group">
      <div class="absolute -left-[29px] md:-left-[37px] top-6 w-3 h-3 rounded-full bg-darkGrey border border-gunSmoke transition-all duration-300 group-hover:bg-accent-light group-hover:border-accent-light group-hover:scale-125 shadow-[0_0_0_4px_rgba(26,26,26,1)]"></div>
      <ExperienceCard
        role="Enterpreneur in Residence"
        company="iHub AWaDH IIT Ropar"
        type="Full-time"
        startDate={new Date(2025, 9)}
        location="Hybrid"
        client:load
      />
    </div>
    <div class="relative group">
      <div class="absolute -left-[29px] md:-left-[37px] top-6 w-3 h-3 rounded-full bg-darkGrey border border-gunSmoke transition-all duration-300 group-hover:bg-accent-light group-hover:border-accent-light group-hover:scale-125 shadow-[0_0_0_4px_rgba(26,26,26,1)]"></div>
      <ExperienceCard
        role="Research Intern"
        company="Annam AI IIT Ropar"
        type="Internship"
        startDate={new Date(2025, 5)}
        endDate={new Date(2025, 9)}
        location="Hybrid"
        client:load
      />
    </div>
    <div class="relative group">
      <div class="absolute -left-[29px] md:-left-[37px] top-6 w-3 h-3 rounded-full bg-darkGrey border border-gunSmoke transition-all duration-300 group-hover:bg-accent-light group-hover:border-accent-light group-hover:scale-125 shadow-[0_0_0_4px_rgba(26,26,26,1)]"></div>
      <ExperienceCard
        role="Flutter Intern"
        company="Stack Wealth (YC S21)"
        type="Internship"
        startDate={new Date(2025, 3)}
        endDate={new Date(2025, 4)}
        location="Remote"
        client:load
      />
    </div>
    <div class="relative group">
      <div class="absolute -left-[29px] md:-left-[37px] top-6 w-3 h-3 rounded-full bg-darkGrey border border-gunSmoke transition-all duration-300 group-hover:bg-accent-light group-hover:border-accent-light group-hover:scale-125 shadow-[0_0_0_4px_rgba(26,26,26,1)]"></div>
      <ExperienceCard
        role="Frontend Intern"
        company="Level SuperMind"
        type="Internship"
        startDate={new Date(2025, 0)}
        endDate={new Date(2025, 1)}
        location="Remote"
        client:load
      />
    </div>
    <div class="relative group">
      <div class="absolute -left-[29px] md:-left-[37px] top-6 w-3 h-3 rounded-full bg-darkGrey border border-gunSmoke transition-all duration-300 group-hover:bg-accent-light group-hover:border-accent-light group-hover:scale-125 shadow-[0_0_0_4px_rgba(26,26,26,1)]"></div>
      <ExperienceCard
        role="Core member—Mobile Development"
        company="Google Developers Group on Campus - NIT Jalandhar"
        type="Self-employed"
        startDate={new Date(2024, 10)}
        location="Jalandhar, Punjab, India"
        client:load
      />
    </div>
  </div>
</div>
