---
interface Props {
  title: string;
  link: string;
  date?: string;
  readTime?: string;
}

const { title, link, date, readTime } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class="cursor-pointer transition-all duration-200 rounded-sm bg-transparent hover:bg-darkGrey/30 border border-transparent hover:border-accent-light p-3 md:p-4 block w-full group"
>
  <!-- Mobile Layout - Stacked -->
  <div class="block md:hidden">
    <!-- Title for mobile -->
    <div class="flex items-start gap-2 mb-3">
      <div class="w-1.5 h-1.5 group-hover:w-2 group-hover:h-2 rounded-full bg-accent-light transition-all duration-200 flex-shrink-0 mt-1.5" />
      <span class="font-ptMono text-quillGray group-hover:text-accent-light text-sm leading-tight transition-colors duration-200 break-words flex-1">
        {title}
      </span>
    </div>
    
    <!-- Date and arrow for mobile -->
    <div class="flex items-center justify-between pl-4">
      {date && (
        <span class="text-xs text-gunSmoke font-ptMono px-2 py-1 bg-darkGrey/20 rounded-sm">
          {date}
        </span>
      )}
      <div class="transition-all duration-200 opacity-70 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0">
        <span class="text-accent-light text-sm">→</span>
      </div>
    </div>
  </div>

  <!-- Desktop Layout - Horizontal -->
  <div class="hidden md:flex md:items-center md:justify-between md:gap-4">
    <!-- Title section for desktop -->
    <div class="flex items-center flex-1 min-w-0 gap-3">
      <div class="w-1.5 h-1.5 group-hover:w-2 group-hover:h-2 rounded-full bg-accent-light transition-all duration-200 flex-shrink-0" />
      <span class="font-ptMono text-quillGray group-hover:text-accent-light text-base leading-tight transition-colors duration-200 truncate">
        {title}
      </span>
    </div>

    <!-- Metadata section for desktop -->
    <div class="flex items-center gap-3 flex-shrink-0">
      {date && (
        <span class="text-sm text-gunSmoke font-ptMono px-3 py-1 bg-darkGrey/20 rounded-sm whitespace-nowrap">
          {date}
        </span>
      )}
      <div class="transition-all duration-200 opacity-70 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0">
        <span class="text-accent-light">→</span>
      </div>
    </div>
  </div>
</a>
